<Project Sdk="Microsoft.NET.Sdk">

  <!-- Which station to fill up at, and how prices move around it: the costs, the ranking, the price trends and their
       rules, as pure functions. Only Essence.Hours (no dependencies of its own) for stations' opening hours and Québec's
       time zones, so it's tested on its own. Essence.Api references it, and Essence.Ingest for its Photon client (the
       stations' addresses, when checking their positions). -->

  <ItemGroup>
    <!-- Québec's boundary, for QuebecArea.Contains (tools/quebec-boundary makes it). -->
    <EmbeddedResource Include="QuebecBoundary.txt" LogicalName="Essence.Ranking.QuebecBoundary.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Essence.Hours\Essence.Hours.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Essence.Ranking.Tests" />
  </ItemGroup>

</Project>
