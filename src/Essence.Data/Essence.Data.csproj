<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Lifts EF Core to the same patch as the Design package (Npgsql alone would flow an older one). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Only for `dotnet ef migrations`; not flowed to the apps. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stations' reviewed position corrections (PositionCorrections): shipped in the assembly, so the API and the ingest
         read the same ones, and a new image brings new ones. -->
    <EmbeddedResource Include="curated-positions.json" LogicalName="Essence.Data.curated-positions.json" />
  </ItemGroup>

</Project>
