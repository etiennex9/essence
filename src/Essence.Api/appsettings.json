{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "None"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "Search": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Health": {
    "MaxImportAgeMinutes": 15
  },
  "Routing": {
    "BaseUrl": "http://routing:5000/",
    "StatusUrl": "http://routing:9090/"
  },
  "Geocoding": {
    "BaseUrl": "http://geocoding:2322/",
    "StatusUrl": "http://geocoding:9090/"
  }
}
