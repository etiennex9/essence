{
  "Logging": {
    "LogLevel": {
      "Essence": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Archive": {
    "Path": "data/archive"
  },
  "Hours": {
    "CachePath": "data/hours",
    "Backoff": [ "00:01:00", "00:02:00", "00:05:00" ]
  }
}
