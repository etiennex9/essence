{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Feed": {
    "Url": "https://regieessencequebec.ca/stations.geojson.gz",
    "PublishInterval": "00:05:00",
    "InitialDelay": "00:00:40",
    "MinDelay": "00:00:20",
    "MaxDelay": "00:02:00",
    "DelayPercentile": 20,
    "DelayHistorySize": 50,
    "FastPollInterval": "00:00:10",
    "FastPollDuration": "00:03:00",
    "SlowPollInterval": "00:01:00",
    "Jitter": "00:00:02",
    "RequestTimeout": "00:00:30",
    "RetryCount": 2,
    "MaxImportAttempts": 3
  },
  "Backfill": {
    "Enabled": true,
    "BaseUrl": "https://regieessencequebec.ca/data/",
    "MaxAge": "01:10:00"
  },
  "Archive": {
    "Path": "/data/archive",
    "RetentionDays": 30
  },
  "Hours": {
    "Enabled": true,
    "CachePath": "/data/hours",
    "UserAgent": "Essence-Ingest/1.0 (station hours)",
    "Every": "7.00:00:00",
    "NightStart": "01:00:00",
    "NightEnd": "05:00:00",
    "StaleAfter": "21.00:00:00",
    "MinShareOfLastGood": 0.8,
    "Backoff": [ "00:15:00", "01:00:00", "06:00:00" ],
    "RematchEvery": "01:00:00",
    "RequestTimeout": "00:00:30",
    "RetryCount": 0,
    "Curated": {
      "Enabled": true
    },
    "Costco": {
      "Enabled": true
    }
  }
}
