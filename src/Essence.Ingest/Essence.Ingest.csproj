<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Essence.Data\Essence.Data.csproj" />
    <ProjectReference Include="..\Essence.Hours\Essence.Hours.csproj" />
    <!-- Photon's client, to look up the stations' addresses when checking their positions (Positions:GeocodingUrl). -->
    <ProjectReference Include="..\Essence.Ranking\Essence.Ranking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hours written down by hand (CuratedHoursSource): shipped in the assembly, so a new image brings new rules. -->
    <EmbeddedResource Include="Hours\curated-hours.json" LogicalName="Essence.Ingest.Hours.curated-hours.json" />
  </ItemGroup>

</Project>
