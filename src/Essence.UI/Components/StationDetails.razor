@implements IDisposable
@inject EssenceApiClient Api
@inject HistoryCache History
@inject HistoryFuels ChartFuels
@inject FavoriteStations Favorites
@inject ComparedStations Comparison
@inject StationHoursView HoursViews
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L

<Pane @ref="_pane" TitleId="ess-details-title" OnClose="OnClose">
    <Header>
        <span class="logo @(_brand.Monogram.Length > 1 ? "is-wide" : null)" style="--logo-bg: @_brand.Background; --logo-fg: @_brand.Foreground">
            @if (_brand.LogoUrl is { } logoUrl)
            {
                <img src="@logoUrl" alt="" />
            }
            else
            {
                @_brand.Monogram
            }
        </span>
        <div class="titles">
            <h2 id="ess-details-title">@(_station is null ? (_error == ApiError.None ? "…" : "") : Title)</h2>
            @if (_station is not null)
            {
                <p>@_station.Address</p>
            }
        </div>
    </Header>
    <Actions>
        @if (_station is not null)
        {
            var favorite = Favorites.IsFavorite(_station.Id);
            <button type="button" class="icon-button star @(favorite ? "is-on" : null)" @onclick="ToggleFavoriteAsync"
                    aria-pressed="@(favorite ? "true" : "false")" aria-label="@L["Favorite"]"
                    title="@(favorite ? L["RemoveFavorite"] : L["AddFavorite"])">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="@(favorite ? "currentColor" : "none")"
                     stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="@Icons.Star" /></svg>
            </button>
        }
    </Actions>
    <ChildContent>
        @if (_error != ApiError.None)
        {
            <p class="message">@(_error == ApiError.NotFound ? L["StationNotFound"] : L["DetailsFailed"])</p>
            @if (_error != ApiError.NotFound)
            {
                <button type="button" class="link" @onclick="LoadAsync">@L["Retry"]</button>
            }
        }
        else if (_station is null)
        {
            <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
        }
        else
        {
            <p class="meta">
                @_station.PostalCode · @_station.Region
                @if (Distance is { } km)
                {
                    <span> · @L["DistanceKm", km.ToString("0.0", CultureInfo.CurrentCulture)]</span>
                }
                @if (_hours.Status is { } status)
                {
                    <span> · <span class="hours @(_hours.Kind == HoursKind.ClosesSoon ? "is-soon" : null)">@status</span></span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(_station.Name) && !string.Equals(_station.Name, _station.Brand, StringComparison.OrdinalIgnoreCase))
            {
                <p class="operator">@_station.Name</p>
            }
            @if (!_station.IsActive)
            {
                <p class="notice">@L["Inactive"]</p>
            }
            else if (_station.Status != "En opération")
            {
                <p class="notice">@_station.Status</p>
            }
            @if (_hours.HolidayCaution)
            {
                <p class="notice">@L["HolidayHoursMayDiffer"]</p>
            }

            <section aria-labelledby="ess-current-prices">
                <h3 id="ess-current-prices">@L["CurrentPrices"]</h3>
                <ul class="prices">
                    @foreach (var price in _station.Prices)
                    {
                        var selected = string.Equals(price.Fuel, Fuel, StringComparison.OrdinalIgnoreCase);
                        <li class="@(selected ? "is-selected" : null)">
                            <span class="fuel"><i class="swatch fuel-@Fuels.IndexOf(price.Fuel)"></i>@price.Fuel</span>
                            @if (price is { IsAvailable: true, PriceCents: { } cents })
                            {
                                <span class="price">@Formatting.Price(cents, CultureInfo.CurrentCulture)<small> ¢/L</small></span>
                            }
                            else
                            {
                                <span class="price is-unavailable">@L["Unavailable"]</span>
                            }
                            <span class="since">@L["Changed", L.Ago(price.Since, _now)]</span>
                        </li>
                    }
                </ul>
            </section>

            <section aria-labelledby="ess-hours">
                <h3 id="ess-hours">@L["Hours"]</h3>
                <StationHours View="_hours" />
            </section>

            <section aria-labelledby="ess-price-history">
                <div class="section-head">
                    <h3 id="ess-price-history">@L["PriceHistory"]</h3>
                    <PeriodSelector Value="_days" ValueChanged="SetPeriodAsync" />
                </div>
                @if (_historyError != ApiError.None)
                {
                    <p class="message">@L["HistoryFailed"]</p>
                    <button type="button" class="link" @onclick="() => LoadHistoryAsync()">@L["Retry"]</button>
                }
                else if (_history is null)
                {
                    <div class="skeleton chart-skeleton" aria-hidden="true"><span></span></div>
                }
                else if (_history.IsEmpty)
                {
                    <p class="message">@L["HistoryEmpty"]</p>
                }
                else if (_shownHistory is { } shown)
                {
                    @if (HistoryFuels.Applies(_history, Fuel))
                    {
                        <div class="chips" role="group" aria-label="@L["HistoryFuels"]">
                            @foreach (var series in _history.Series)
                            {
                                var locked = HistoryFuels.IsMapFuel(series.Key, Fuel);
                                var on = ChartFuels.IsShown(series.Key, Fuel);
                                <button type="button" @key="series.Key" class="chip @(on ? "is-on" : null) @(locked ? "is-locked" : null)"
                                        aria-pressed="@(on ? "true" : "false")" aria-disabled="@(locked ? "true" : null)"
                                        title="@(locked ? L["HistoryMapFuel"].Value : null)" @onclick="() => ToggleFuelAsync(series.Key)">
                                    <i class="swatch fuel-@series.Color"></i>@series.Label
                                </button>
                            }
                        </div>
                    }
                    <PriceHistoryChart Data="shown" Highlight="@HistoryFuels.Highlight(shown, Fuel)" />
                }
            </section>

            <div class="actions">
                @if (_station is { Latitude: { } lat, Longitude: { } lon })
                {
                    <GoLink class="directions" Href="@GoogleMaps.Directions(lat, lon)" Hours="_station.Hours" Latitude="lat" Longitude="lon"
                            EtaMinutes="Eta" Name="@Title">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Directions" /></svg>
                        @L["Directions"]
                    </GoLink>
                }
                @{
                    var compared = Comparison.Contains(_station.Id);
                    var full = !compared && Comparison.IsFull;
                }
                <button type="button" class="compare @(compared ? "is-on" : null)" @onclick="ToggleComparedAsync" disabled="@full"
                        aria-pressed="@(compared ? "true" : "false")"
                        title="@(full ? L["ComparisonFull", ComparedStations.MaxStations].Value : compared ? L["RemoveFromComparison", Title].Value : null)">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="@(compared ? Icons.Check : Icons.Compare)" /></svg>
                    @L["Compare"]
                </button>
            </div>
        }
    </ChildContent>
</Pane>

@code {
    private Pane? _pane;
    private CancellationTokenSource? _stationCts;
    private CancellationTokenSource? _historyCts;
    private long _loadedId;
    private StationDetail? _station;
    private ApiError _error;
    private PriceChartData? _history;

    /// <summary>The lines of <see cref="_history"/> drawn. Kept, not worked out in the markup: a new chart drops the hover.</summary>
    private PriceChartData? _shownHistory;

    private string? _shownFuel;
    private ApiError _historyError;
    private int _days = 30;
    private DateTimeOffset _now;
    private BrandStyle _brand = BrandCatalog.For(null);

    /// <summary>The station's hours now; shown again when that changes (<see cref="_hoursTimer"/>).</summary>
    private HoursView _hours = HoursView.Unknown;

    /// <summary>Fires when the hours shown change next: the station starts closing soon, closes or opens.</summary>
    private ITimer? _hoursTimer;

    private bool _disposed;

    /// <summary>When the prices shown were imported, as the API said with them.</summary>
    private DateTimeOffset? _shownDataAsOf;

    [Parameter, EditorRequired]
    public long StationId { get; set; }

    /// <summary>The fuel selected on the map, highlighted in the prices and always drawn in the chart.</summary>
    [Parameter]
    public string? Fuel { get; set; }

    [Parameter]
    public GeoPoint? UserLocation { get; set; }

    /// <summary>
    /// How long getting to the station takes, by road, when the details were opened from Best near you or the trip (its ETA
    /// there); null otherwise, and Directions estimates it from the straight line.
    /// </summary>
    [Parameter]
    public double? EtaMinutes { get; set; }

    /// <summary>When the map's prices were imported: once they're newer than the pane's, the pane refreshes too.</summary>
    [Parameter]
    public DateTimeOffset? DataAsOf { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Raised with the station once it's loaded, so the map can bring it into view; again when its marker is tapped while the
    /// pane is open (<see cref="ShowAgainAsync"/>).
    /// </summary>
    [Parameter]
    public EventCallback<StationDetail> OnLoaded { get; set; }

    private string Title => _station?.Brand ?? _station?.Name ?? L["Independent"];

    private double? Distance => (UserLocation, _station) is ({ } user, { Latitude: { } lat, Longitude: { } lon })
        ? Geo.DistanceKm(user, new GeoPoint(lat, lon))
        : null;

    /// <summary>
    /// How long getting there takes, for Directions' warning when the station closes soon after: Best's ETA, or the
    /// straight line's estimate (as the API's without routing); null without a location, and its hours are checked now.
    /// </summary>
    private double? Eta => EtaMinutes ?? (Distance is { } km ? StationHoursView.EstimatedMinutes(km) : null);

    protected override async Task OnInitializedAsync()
    {
        _now = Time.GetUtcNow();
        Favorites.Changed += OnListsChanged;
        Comparison.Changed += OnListsChanged;
        await Favorites.LoadAsync();
        await Comparison.LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (Fuel != _shownFuel)
        {
            _shownFuel = Fuel;
            ShowHistory();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (StationId != _loadedId)
        {
            // Another station, tapped on the map: a sheet shrunk to its header comes back to show it.
            var another = _loadedId != 0;
            _loadedId = StationId;
            if (another && _pane is not null)
            {
                await _pane.RestoreAsync();
            }

            await LoadAsync();
        }
        else if (_station is not null && DataAsOf > _shownDataAsOf)
        {
            await RefreshAsync();
        }
    }

    private async Task LoadAsync()
    {
        _station = null;
        _error = ApiError.None;
        _brand = BrandCatalog.For(null);
        _now = Time.GetUtcNow();
        ShowHours();

        _stationCts?.Cancel();
        var cts = _stationCts = new CancellationTokenSource();
        var history = LoadHistoryAsync();
        try
        {
            var result = await Api.GetStationAsync(StationId, cts.Token);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _station = result.Value;
            _error = result.Error;
            _shownDataAsOf = result.DataAsOf;
            if (_station is not null)
            {
                _brand = BrandCatalog.For(_station.Brand);
                ShowHours();
                StateHasChanged();
                await OnLoaded.InvokeAsync(_station);
                await Favorites.RefreshAsync(_station);
                await Comparison.RefreshAsync(_station);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await history;
    }

    /// <summary>
    /// Newer prices came in while the pane is open: updates it in place, without the skeleton, and without raising
    /// <see cref="OnLoaded"/> (the map mustn't move by itself). The chart reloads if a price changed. A failure keeps what's shown.
    /// </summary>
    private async Task RefreshAsync()
    {
        _shownDataAsOf = DataAsOf;
        _stationCts?.Cancel();
        var cts = _stationCts = new CancellationTokenSource();
        try
        {
            var result = await Api.GetStationAsync(StationId, cts.Token);
            if (cts.IsCancellationRequested || result.Value is not { } station)
            {
                return;
            }

            var pricesChanged = _station is null || !station.Prices.SequenceEqual(_station.Prices);
            _station = station;
            _shownDataAsOf = result.DataAsOf > DataAsOf ? result.DataAsOf : DataAsOf;
            _now = Time.GetUtcNow();
            ShowHours();
            StateHasChanged();
            if (pricesChanged)
            {
                await LoadHistoryAsync(refresh: true);
            }
        }
        catch (OperationCanceledException)
        {
            // The pane moved on to another station.
        }
    }

    private async Task SetPeriodAsync(int days)
    {
        _days = days;
        await LoadHistoryAsync();
    }

    /// <param name="refresh">Fetches past the cache, and keeps the chart shown until the new one is in.</param>
    private async Task LoadHistoryAsync(bool refresh = false)
    {
        if (!refresh)
        {
            _history = null;
            _historyError = ApiError.None;
            ShowHistory();
        }

        _historyCts?.Cancel();
        var cts = _historyCts = new CancellationTokenSource();
        try
        {
            // Here and not on init: the map rendering meanwhile starts this load anyway, and a cached history could beat the saved fuels.
            await ChartFuels.LoadAsync();
            var result = await History.GetAsync(StationId, _days, cts.Token, refresh);
            if (cts.IsCancellationRequested || (refresh && !result.IsSuccess))
            {
                return;
            }

            _historyError = result.Error;
            _history = result.Value is { } history ? HistorySeries.Build(history.Rows, history.From, history.To) : null;
            ShowHistory();
        }
        catch (OperationCanceledException)
        {
            // A newer request replaced this one.
        }
    }

    private void ShowHistory() => _shownHistory = _history is { } chart ? ChartFuels.Filter(chart, Fuel) : null;

    /// <summary>
    /// The station's hours as of now, and a timer for when they change next, which shows them again then: "Open until
    /// 9:30 p.m." turns amber half an hour before, then "Closed · opens 6:00 a.m." at 9:30.
    /// </summary>
    private void ShowHours()
    {
        _hoursTimer?.Dispose();
        _hoursTimer = null;
        var now = Time.GetUtcNow();
        _hours = _station is { } station ? HoursViews.Describe(station.Hours, station.Latitude, station.Longitude, now) : HoursView.Unknown;
        if (_disposed || _hours.RefreshAt is not { } at)
        {
            return;
        }

        // A second past the change, so it's surely past it then; one already past runs at once.
        var due = at - now + TimeSpan.FromSeconds(1);
        _hoursTimer = Time.CreateTimer(_ => InvokeAsync(OnHoursChanged), null, due > TimeSpan.Zero ? due : TimeSpan.Zero, Timeout.InfiniteTimeSpan);
    }

    private void OnHoursChanged()
    {
        if (_disposed)
        {
            return;
        }

        _now = Time.GetUtcNow();
        ShowHours();
        StateHasChanged();
    }

    private async Task ToggleFuelAsync(string fuel)
    {
        if (await ChartFuels.ToggleAsync(fuel, Fuel))
        {
            ShowHistory();
        }
    }

    private Task ToggleFavoriteAsync()
    {
        if (_station is not { } station)
        {
            return Task.CompletedTask;
        }

        return Favorites.IsFavorite(station.Id) ? Favorites.RemoveAsync(station.Id) : Favorites.AddAsync(SavedStation.From(station));
    }

    private Task ToggleComparedAsync()
    {
        if (_station is not { } station)
        {
            return Task.CompletedTask;
        }

        return Comparison.Contains(station.Id) ? Comparison.RemoveAsync(station.Id) : Comparison.AddAsync(SavedStation.From(station));
    }

    private void OnListsChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The station's marker tapped while its details are open: a sheet shrunk to its header comes back, and the map brings
    /// the station out from under it (<see cref="OnLoaded"/>, once the station is loaded).
    /// </summary>
    public async Task ShowAgainAsync()
    {
        if (_pane is not null)
        {
            await _pane.RestoreAsync();
        }

        if (_station is not null)
        {
            await OnLoaded.InvokeAsync(_station);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Favorites.Changed -= OnListsChanged;
        Comparison.Changed -= OnListsChanged;
        _stationCts?.Cancel();
        _historyCts?.Cancel();
        _hoursTimer?.Dispose();
    }
}
