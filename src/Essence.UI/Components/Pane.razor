@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<Strings> L

@* The pane the station details and the lists open in: a side panel on wide screens, a bottom sheet on narrow ones
   (see the CSS), whose header drags to resize or close it (essencePane.js). data-ess-pane lets the map pan a station
   out from under it. *@
<aside class="pane @(Expanded ? "is-expanded" : null)" @ref="_element" data-ess-pane role="dialog" aria-labelledby="@TitleId">
    <div class="handle" aria-hidden="true"></div>

    <header>
        @Header
        @Actions
        <button type="button" class="icon-button" @onclick="OnClose" aria-label="@L["Close"]" title="@L["Close"]">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round"><path d="@Icons.Close" /></svg>
        </button>
    </header>

    <div class="body">
        @ChildContent
    </div>
</aside>

@code {
    private const string ModulePath = "./_content/Essence.UI/js/essencePane.js";

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _sheet;
    private DotNetObjectReference<Pane>? _self;
    private bool _disposed;

    /// <summary>The id of the heading in <see cref="Header"/>, which names the dialog.</summary>
    [Parameter, EditorRequired]
    public string TitleId { get; set; } = "";

    /// <summary>Takes the header's free width, before <see cref="Actions"/> and the Close button.</summary>
    [Parameter]
    public RenderFragment? Header { get; set; }

    /// <summary>Icon buttons before Close.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>On phones, the sheet opens at its full height (it can still be dragged down): for a search typed on the keyboard.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>The Close button, or the sheet dragged away.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _sheet = await _module.InvokeAsync<IJSObjectReference>("attachSheet", _element, _self);
        if (_disposed)
        {
            // Closed while the module was loading.
            await DetachAsync();
        }
    }

    [JSInvokable]
    public Task OnSheetDismissed() => OnClose.InvokeAsync();

    /// <summary>Scrolls the body up to <paramref name="element"/> when it's above what the body shows.</summary>
    public async Task RevealAsync(ElementReference element)
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("reveal", element);
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DetachAsync();
    }

    private async ValueTask DetachAsync()
    {
        try
        {
            if (_sheet is not null)
            {
                await _sheet.InvokeVoidAsync("dispose");
                await _sheet.DisposeAsync();
                _sheet = null;
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
                _module = null;
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the pane goes with it.
        }

        _self?.Dispose();
    }
}
