@implements IDisposable
@inject BestNearYou Best
@inject CarProfiles Cars
@inject TripState Trips
@inject SavedPlaces Places
@inject ServicesStatus Services
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L

@* Best near you: the station worth going to (the hero), the closest, best value and cheapest at a glance, a few others that
   save, and what it was worked out for, with "Going somewhere?" above them. With Trip, Best on the way: the trip, the range,
   where to stop, and the stations along the route. The rankings are the API's (/stations/best, /trips/best); BestNearYou and
   TripState keep the latest. *@
<Pane TitleId="ess-best-title" OnClose="OnClose">
    <Header>
        <h2 id="ess-best-title" class="title">@(Trip ? L["BestOnTheWay"] : L["BestNearYou"])</h2>
    </Header>
    <Actions>
        <button type="button" class="car" @onclick="OnOpenCars" aria-label="@L["CarChipLabel", CarName]" title="@L["CarChipLabel", CarName]">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M3 17v-4l2-5h14l2 5v4M7 17v2M17 17v2M7.5 13.5h.01M16.5 13.5h.01" /></svg>
            <span>@CarName</span>
            <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
        </button>
    </Actions>
    <ChildContent>
        @if (Trip)
        {
            @* ---- Best on the way ---- *@
            @if (Trips.Destination is not { } destination)
            {
                <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
            }
            else
            {
                var plan = Trips.Plan;
                <div class="trip-bar">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="@DestinationIcon(destination)" /></svg>
                    <span class="tx">
                        <b>@TripTitle(destination)</b>
                        @if (plan is not null)
                        {
                            <span>@($"{L["DistanceByRoad", Formatting.Km(plan.DistanceKm, CultureInfo.CurrentCulture)]} · {Formatting.Duration(plan.DurationMin, CultureInfo.CurrentCulture)}")</span>
                        }
                    </span>
                    <button type="button" class="end" @onclick="OnEndTrip" aria-label="@L["EndTrip"]" title="@L["EndTrip"]">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round"><path d="@Icons.Close" /></svg>
                    </button>
                </div>

                @if (plan is null || Trips.PlanQuery is not { } query)
                {
                    @if (Trips.Loading)
                    {
                        <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
                    }
                    else
                    {
                        <p class="message">@TripError</p>
                        <div class="choices">
                            @if (Trips.Error is not ApiError.NoRoute)
                            {
                                <button type="button" class="secondary" @onclick="Trips.RetryAsync">@L["Retry"]</button>
                            }
                            <button type="button" class="secondary" @onclick="OnEndTrip">@L["EndTrip"]</button>
                        </div>
                    }
                }
                else
                {
                    var stations = plan.Stations;
                    var pick = TripFind(plan, plan.PickId);
                    var reference = TripFind(plan, plan.ReferenceId);
                    <div class="result @(Trips.Loading ? "is-loading" : null)" aria-busy="@(Trips.Loading ? "true" : "false")">
                        <div class="chips">
                            @if (plan.LongTrip)
                            {
                                @if (query.RangeKm is { } rangeKm && Cars.Active.RangeAt is { } rangeAt)
                                {
                                    <button type="button" class="chip is-range" aria-pressed="@(_editingRange ? "true" : "false")" @onclick="EditRange"
                                            aria-label="@L["RangeChipLabel", rangeKm, RangeTime(rangeAt)]">
                                        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Pump" /></svg>
                                        @L["RangeChip", rangeKm, RangeTime(rangeAt)]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="chip is-range is-unset" aria-pressed="@(_editingRange ? "true" : "false")" @onclick="EditRange">
                                        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Pump" /></svg>
                                        @L["RangeAdd"]
                                    </button>
                                }
                            }
                            <button type="button" class="chip" @onclick="OnOpenCars" aria-label="@L["DetourChipLabel", query.MaxDetourMinutes]">
                                @L["DetourChip", query.MaxDetourMinutes]
                            </button>
                            @if (!plan.LongTrip)
                            {
                                <span class="chip is-quiet">@L["ShortTrip"]</span>
                            }
                        </div>

                        @if (plan.LongTrip && (_editingRange || query.RangeKm is null))
                        {
                            <form class="range-edit" @onsubmit="SaveRangeAsync">
                                @if (query.RangeKm is null)
                                {
                                    <p>@L["RangeAsk"]</p>
                                }
                                <div class="range-row">
                                    <label for="ess-range">@L["RangeLabel"]</label>
                                    <span class="number">
                                        <input id="ess-range" type="number" inputmode="numeric" min="0" max="@CarProfile.MaxRangeKm" step="1"
                                               @bind="_rangeText" @bind:event="oninput" />
                                        <span class="unit">km</span>
                                    </span>
                                    <button type="submit" class="save">@L["Save"]</button>
                                    @if (query.RangeKm is not null)
                                    {
                                        <button type="button" class="link" @onclick="() => _editingRange = false">@L["Cancel"]</button>
                                    }
                                </div>
                            </form>
                        }

                        @if (pick is null || reference is null)
                        {
                            <p class="need">@L["NoReachableStation"]</p>
                        }
                        else if (plan.LowFuel)
                        {
                            <p class="need"><b>@L["LowFuel"]</b> @L["LowFuelWhy", query.RangeKm ?? 0, query.SpareKm]</p>
                        }
                        else if (plan.StopBeforeKm is { } stopKm)
                        {
                            <p class="need"><b>@L["StopBefore", Math.Round(stopKm)]</b> @L["StopBeforeWhy", query.RangeKm ?? 0, query.SpareKm]</p>
                        }
                        else if (plan.LongTrip && query.RangeKm is { } coveredKm)
                        {
                            <p class="need is-fine"><b>@L["NoStopNeeded"]</b> @L["NoStopNeededWhy", coveredKm, query.SpareKm]</p>
                        }

                        @if (pick is not null && reference is not null)
                        {
                            <section class="hero" aria-labelledby="ess-trip-pick">
                                <div class="top">
                                    @Logo(pick.Brand, "logo")
                                    <div class="who">
                                        <h3 id="ess-trip-pick">
                                            @NameOf(pick.Brand)
                                            @if (pick.MembersOnly)
                                            {
                                                <span class="tag">@L["Members"]</span>
                                            }
                                        </h3>
                                        <p>@($"{pick.Address} · {L["KmAlong", Math.Round(pick.KmAlong)]} · {Detour(pick)}")</p>
                                    </div>
                                    <span class="big">@Price(pick.PriceCents)<small> ¢/L</small></span>
                                </div>
                                @if (pick.Id != reference.Id)
                                {
                                    <p class="saves">@L["Saves", Money(pick.SavesDollars)]</p>
                                    <p class="why">
                                        @(L[plan.ReferenceOnTheWay ? "TripWhy" : "TripWhySmallestDetour", Litres(query.FillLitres), NameOf(reference.Brand),
                                            Math.Round(reference.KmAlong), Price(reference.PriceCents)])
                                    </p>
                                }
                                else
                                {
                                    <p class="saves is-neutral">@(plan.ReferenceOnTheWay ? L["OnYourWay"] : L["SmallestDetour"])</p>
                                    <p class="why">@PickIsReferenceWhy(plan, query)</p>
                                }
                                <div class="actions">
                                    <a class="go" target="_blank" rel="noopener"
                                       href="@GoogleMaps.DirectionsVia(destination.Latitude, destination.Longitude, pick.Latitude, pick.Longitude, navigate: true)">
                                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"
                                             stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Directions" /></svg>
                                        @L["GoViaGoogleMaps"]
                                    </a>
                                    <button type="button" class="secondary" @onclick="() => OnOpenStation.InvokeAsync(pick.Id)">@L["Details"]</button>
                                </div>
                            </section>

                            @if (stations.Count(s => s.Reachable) > 1)
                            {
                                var third = TripFind(plan, plan.BiggestSavingId);
                                var cheapest = stations.Where(s => s.Reachable).OrderBy(s => s.PriceCents).ThenBy(s => s.CostDollars).First();
                                <div class="tiles">
                                    @Tile(plan.ReferenceOnTheWay ? L["NoDetour"] : L["SmallestDetour"], reference.Id, reference.Brand, reference.PriceCents,
                                        false, TripSub(reference))
                                    @Tile(L["BestValue"], pick.Id, pick.Brand, pick.PriceCents, true, TripSub(pick))
                                    @if (third is not null)
                                    {
                                        @Tile(L["BiggestSaving"], third.Id, third.Brand, third.PriceCents, false, TripSub(third),
                                            third.OverDetourLimit ? L["OverMinutes", query.MaxDetourMinutes] : L["Saves", Money(third.SavesDollars)])
                                    }
                                    else
                                    {
                                        @Tile(L["Cheapest"], cheapest.Id, cheapest.Brand, cheapest.PriceCents, false,
                                            cheapest.Id == pick.Id ? L["SameAsBest"] : TripSub(cheapest))
                                    }
                                </div>
                            }
                        }

                        @if (stations.Count > 0)
                        {
                            <button type="button" class="more" aria-expanded="@(_allStations ? "true" : "false")" aria-controls="ess-trip-stations"
                                    @onclick="() => _allStations = !_allStations">
                                @(_allStations ? L["FewerStations"] : L["AllStationsOnTheWay", stations.Count])
                            </button>
                            @if (_allStations)
                            {
                                <ul class="on-way" id="ess-trip-stations" aria-label="@L["StationsOnTheWay"]">
                                    @foreach (var station in stations)
                                    {
                                        var (statusClass, statusText) = Status(station, reference, query);
                                        <li @key="station.Id" class="@(station.Reachable ? null : "is-out")">
                                            <button type="button" class="row" @onclick="() => OnOpenStation.InvokeAsync(station.Id)">
                                                <span class="km">
                                                    @L["KmAlong", Math.Round(station.KmAlong)]
                                                    <small>@(IsOnTheWay(station) ? L["NoDetour"] : L["DetourMinutesShort", Math.Round(station.DetourMin)])</small>
                                                </span>
                                                @Logo(station.Brand, "logo small")
                                                <span class="name">
                                                    @NameOf(station.Brand)
                                                    @if (station.MembersOnly)
                                                    {
                                                        <span class="tag">@L["Members"]</span>
                                                    }
                                                </span>
                                                <span class="address">@station.Address</span>
                                                <span class="price">@Price(station.PriceCents)</span>
                                                <span class="row-saves @statusClass">@statusText</span>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        }

                        <p class="foot">
                            @(Trips.FromMapCenter || Trips.PlannedAt is not { } plannedAt
                                ? L["TripFromMapCenter"]
                                : L["TripPlannedAt", Formatting.TimeOfDay(plannedAt, TimeZoneInfo.Local, CultureInfo.CurrentCulture)])
                            @(" ")
                            <button type="button" class="link" @onclick="OnRefreshTrip">@L["Refresh"]</button>
                        </p>
                        <p class="foot">
                            @CarFooter(query.FillLitres, query.LitresPer100Km, query.CostcoMember)
                            @(" ")
                            <button type="button" class="link" @onclick="OnOpenCars">@(Cars.IsTypical ? L["SetUpYourCar"] : L["Change"])</button>
                            @if (pick is not null)
                            {
                                @(" ")
                                @L["GoViaNote", NameOf(pick.Brand)]
                            }
                            @if (SavedPlaceOf(destination) is { } saved)
                            {
                                @(" ")
                                <button type="button" class="link" @onclick="() => Places.RemoveAsync(saved.Id)">@L["ForgetPlace"]</button>
                            }
                        </p>
                    </div>
                }
            }
        }
        else
        {
            @* ---- Going somewhere? ---- *@
            @if (TripsUnavailable)
            {
                <p class="where-off" role="status">@TripsUnavailableText</p>
            }
            else
            {
                var otherPlaces = Places.Places.Where(p => p.Kind == PlaceKind.Other).ToList();
                <div class="where">
                    <div class="where-row" role="group" aria-label="@L["SavedPlacesLabel"]">
                        <button type="button" class="wbox" @onclick="() => OnSearchPlaces.InvokeAsync(PlacePurpose.Destination)">
                            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"><path d="@Icons.Search" /></svg>
                            @L["GoingSomewhere"]
                        </button>
                        @PlaceButton(PlaceKind.Home, Places.Home, L["Home"], Icons.Home)
                        @PlaceButton(PlaceKind.Work, Places.Work, L["Work"], Icons.Work)
                        @foreach (var place in otherPlaces)
                        {
                            <button type="button" class="place" @key="place.Id" @onclick="() => OnStartTrip.InvokeAsync(TripDestination.To(place))">
                                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Place" /></svg>
                                <span>@place.Name</span>
                            </button>
                        }
                    </div>
                    <p class="where-help">
                        <span class="touch">@L["GoingSomewhereTouch"]</span>
                        <span class="mouse">@L["GoingSomewhereMouse"]</span>
                        @(" ")
                        <button type="button" class="link" @onclick="OnDropPinAtCenter">@L["UseMapCenterAsDestination"]</button>
                    </p>
                </div>
            }

            @* ---- Best near you ---- *@
            @if (Best.Origin is not { } origin)
            {
                @if (Locating)
                {
                    <p class="message">@L["Locating"]</p>
                    <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
                }
                else
                {
                    <p class="message">
                        @if (LocationProblem is { } problem)
                        {
                            @(problem == LocationStatus.Denied ? L["LocationDenied"] : L["LocationUnavailable"])
                            @(" ")
                        }
                        @L["BestNeedsLocation"]
                    </p>
                    <div class="choices">
                        <button type="button" class="secondary" @onclick="OnLocate">@L["UseMyLocation"]</button>
                        <button type="button" class="secondary" @onclick="OnUseMapCenter">@L["UseMapCenter"]</button>
                    </div>
                }
            }
            else if (Best.Result is not { } result || Best.ResultQuery is not { } query)
            {
                @if (Best.Error != ApiError.None && !Best.Loading)
                {
                    <p class="message">@(Best.Error == ApiError.RateLimited ? L["BestRateLimited"] : L["BestFailed"])</p>
                    <button type="button" class="link" @onclick="Best.RetryAsync">@L["Retry"]</button>
                }
                else
                {
                    <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
                }
            }
            else
            {
                <div class="result @(Best.Loading ? "is-loading" : null)" aria-busy="@(Best.Loading ? "true" : "false")">
                    @if (origin.IsMapCenter)
                    {
                        <p class="origin">
                            @L["BestAtMapCenter"]
                            @(" ")
                            <button type="button" class="link" @onclick="OnLocate">@L["UseMyLocation"]</button>
                        </p>
                    }
                    else if (origin.IsApproximate)
                    {
                        <p class="origin">
                            @L["BestApproximate", Math.Round(origin.AccuracyMeters!.Value / 1000)]
                            @(" ")
                            <button type="button" class="link" @onclick="OnUseMapCenter">@L["UseMapCenter"]</button>
                        </p>
                    }

                    @if (result.Pick is not { } pick)
                    {
                        <p class="message">@L["BestNoPrices", query.Fuel]</p>
                    }
                    else
                    {
                        var reference = Find(result, result.ReferenceId) ?? pick;
                        var cheapest = Find(result, result.CheapestId) ?? pick;
                        @if (result.RadiusKm is null)
                        {
                            <p class="message">@L["BestNothingWithin", WideRadiusKm]</p>
                        }

                        <section class="hero" aria-labelledby="ess-best-pick">
                            <div class="top">
                                @Logo(pick.Brand, "logo")
                                <div class="who">
                                    <h3 id="ess-best-pick">
                                        @NameOf(pick.Brand)
                                        @if (pick.MembersOnly)
                                        {
                                            <span class="tag">@L["Members"]</span>
                                        }
                                    </h3>
                                    <p>@pick.Address · @Away(pick)</p>
                                </div>
                                <span class="big">@Price(pick.PriceCents)<small> ¢/L</small></span>
                            </div>
                            @if (pick.Id != result.ReferenceId)
                            {
                                <p class="saves">@L["Saves", Money(pick.SavesDollars)]</p>
                                <p class="why">
                                    @L["BestWhy", Litres(query.FillLitres), Distance(2 * pick.DistanceKm), NameOf(reference.Brand), Distance(reference.DistanceKm), Price(reference.PriceCents)]
                                </p>
                            }
                            else if (result.RadiusKm is not null)
                            {
                                var blocked = result.Stations.FirstOrDefault(s => s.Id != pick.Id && s.SavesDollars >= SmallestSaving);
                                @if (blocked is not null)
                                {
                                    <p class="saves is-neutral">@L["ClosestStation"]</p>
                                    <p class="why">@(blocked.OverDetourLimit ? L["BestWhyDetour", query.MaxDetourMinutes] : L["BestWhyUncertain"])</p>
                                }
                                else if (result.Stations.Count == 1)
                                {
                                    <p class="why">@L["BestWhyOnly", query.Fuel]</p>
                                }
                                else
                                {
                                    <p class="saves is-neutral">@L["AboutTheSame"]</p>
                                    <p class="why">@L["BestWhyNothingSaves", Money(SmallestSaving), Litres(query.FillLitres)]</p>
                                }
                            }
                            <div class="actions">
                                <a class="go" target="_blank" rel="noopener" href="@GoogleMaps.Directions(pick.Latitude, pick.Longitude, navigate: true)">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"
                                         stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Directions" /></svg>
                                    @L["GoGoogleMaps"]
                                </a>
                                <button type="button" class="secondary" @onclick="() => OnOpenStation.InvokeAsync(pick.Id)">@L["Details"]</button>
                            </div>
                        </section>

                        @if (result.Stations.Count > 1)
                        {
                            <div class="tiles">
                                @Tile(L["Closest"], reference.Id, reference.Brand, reference.PriceCents, false, NearSub(reference))
                                @Tile(L["BestValue"], pick.Id, pick.Brand, pick.PriceCents, true, pick.Id == reference.Id ? L["SameAsClosest"] : NearSub(pick))
                                @Tile(L["Cheapest"], cheapest.Id, cheapest.Brand, cheapest.PriceCents, false,
                                    cheapest.Id == pick.Id ? L["SameAsBest"] : NearSub(cheapest))
                            </div>
                        }

                        var others = Others(result, pick);
                        @if (others.Count > 0)
                        {
                            <h3 class="others-title" id="ess-best-others">@L["AlsoWorthIt"]</h3>
                            <ul class="others" aria-labelledby="ess-best-others">
                                @foreach (var station in others)
                                {
                                    <li @key="station.Id">
                                        <button type="button" class="row" @onclick="() => OnOpenStation.InvokeAsync(station.Id)">
                                            @Logo(station.Brand, "logo small")
                                            <span class="name">
                                                @NameOf(station.Brand)
                                                @if (station.MembersOnly)
                                                {
                                                    <span class="tag">@L["Members"]</span>
                                                }
                                            </span>
                                            <span class="address">@station.Address · @Away(station)</span>
                                            <span class="price">@Price(station.PriceCents)</span>
                                            @if (station.OverDetourLimit)
                                            {
                                                <span class="row-saves is-blocked">@L["SavesOverDetour", Money(station.SavesDollars), query.MaxDetourMinutes]</span>
                                            }
                                            else if (station.SavingUncertain)
                                            {
                                                <span class="row-saves is-blocked">@L["SavesUncertain", Money(station.SavesDollars)]</span>
                                            }
                                            else
                                            {
                                                <span class="row-saves">@L["Saves", Money(station.SavesDollars)]</span>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    }

                    <p class="foot">
                        @if (result.RadiusKm is { } radiusKm)
                        {
                            @(radiusKm > DefaultRadiusKm ? L["FooterWidened", radiusKm] : L["FooterWithin", radiusKm])
                            @(" ")
                        }
                        @CarFooter(query.FillLitres, query.LitresPer100Km, query.CostcoMember)
                        @if (!result.ByRoad)
                        {
                            @(" ")
                            @L["FooterEstimated"]
                        }
                        @(" ")
                        <button type="button" class="link" @onclick="OnOpenCars">@(Cars.IsTypical ? L["SetUpYourCar"] : L["Change"])</button>
                    </p>
                </div>
            }
        }
    </ChildContent>
</Pane>

@code {
    /// <summary>Savings under this are "about the same" (Essence.Ranking's NearYou.SmallestSaving).</summary>
    private const decimal SmallestSaving = 0.25m;

    /// <summary>The API's search radius (Essence.Ranking's SearchArea): the default, and the widest.</summary>
    private const double DefaultRadiusKm = 10;
    private const double WideRadiusKm = 25;

    /// <summary>"Also worth it" shows at most this many stations.</summary>
    private const int MaxOthers = 3;

    /// <summary>A stop that adds at most this is on the way (Essence.Ranking's OnTheWay.NoDetourKm and NoDetourMinutes).</summary>
    private const double NoDetourKm = 1.0;
    private const double NoDetourMinutes = 2.0;

    /// <summary>The range is being typed, after a tap on its chip.</summary>
    private bool _editingRange;

    private string _rangeText = "";

    /// <summary>Every station on the way is listed, not only the pick and the tiles.</summary>
    private bool _allStations;

    /// <summary>Best on the way instead of Best near you: the trip <see cref="TripState"/> has open.</summary>
    [Parameter]
    public bool Trip { get; set; }

    /// <summary>The device's location is being asked for.</summary>
    [Parameter]
    public bool Locating { get; set; }

    /// <summary>Why the location isn't known, after asking for it failed.</summary>
    [Parameter]
    public LocationStatus? LocationProblem { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<long> OnOpenStation { get; set; }

    [Parameter]
    public EventCallback OnOpenCars { get; set; }

    /// <summary>Asks for the device's location again.</summary>
    [Parameter]
    public EventCallback OnLocate { get; set; }

    /// <summary>Ranks from the map's centre instead of the device's location.</summary>
    [Parameter]
    public EventCallback OnUseMapCenter { get; set; }

    /// <summary>A trip to a saved place, from "Going somewhere?".</summary>
    [Parameter]
    public EventCallback<TripDestination> OnStartTrip { get; set; }

    /// <summary>Closes the trip, back to Best near you.</summary>
    [Parameter]
    public EventCallback OnEndTrip { get; set; }

    /// <summary>Plans the trip again from where the user is now.</summary>
    [Parameter]
    public EventCallback OnRefreshTrip { get; set; }

    /// <summary>The address search: for a trip ("Going somewhere?"), or to set Home or Work (tapped before they're saved).</summary>
    [Parameter]
    public EventCallback<PlacePurpose> OnSearchPlaces { get; set; }

    /// <summary>Drops a pin at the map's centre: the keyboard's way to pick a destination.</summary>
    [Parameter]
    public EventCallback OnDropPinAtCenter { get; set; }

    private string CarName => Cars.IsTypical || string.IsNullOrWhiteSpace(Cars.Active.Name) ? L["MyCar"] : Cars.Active.Name;

    /// <summary>
    /// Trips can't be planned now: the routing data is being prepared, the routing server answered 503, or Best near you
    /// fell back to estimates.
    /// </summary>
    private bool TripsUnavailable => Services.RoutingPreparing || Trips.Unavailable || Best.Result is { ByRoad: false, Pick: not null };

    /// <summary>
    /// "Trips will be ready soon: preparing Québec's road map (45 %)", that preparing it failed and is tried again at a
    /// time, or that they aren't available.
    /// </summary>
    private string TripsUnavailableText => ServicesStatus.Note(Services.Routing, L, "Trips") ?? L["TripsUnavailableShort"];

    private string TripError => Trips.Error switch
    {
        ApiError.Unavailable when Services.RoutingPreparing => TripsUnavailableText,
        ApiError.Unavailable => L["TripUnavailable"],
        ApiError.NoRoute => L["TripNoRoad"],
        ApiError.RateLimited => L["TripRateLimited"],
        _ => L["TripFailed"],
    };

    protected override async Task OnInitializedAsync()
    {
        Best.Changed += OnChanged;
        Cars.Changed += OnChanged;
        Trips.Changed += OnChanged;
        Places.Changed += OnChanged;
        Services.Changed += OnChanged;
        await Cars.LoadAsync();
        await Places.LoadAsync();
    }

    protected override void OnParametersSet()
    {
        if (!Trip)
        {
            (_editingRange, _allStations) = (false, false);
        }
    }

    /// <summary>Home or Work: a trip there once it's saved, until then the address search to set it.</summary>
    private RenderFragment PlaceButton(PlaceKind kind, SavedPlace? place, string label, string icon) =>
        @<button type="button" class="place @(place is null ? "is-unset" : null)" aria-label="@(place is null ? (string)L["SetPlaceLabel", label] : null)"
                 @onclick="() => place is null
                     ? OnSearchPlaces.InvokeAsync(kind == PlaceKind.Home ? PlacePurpose.Home : PlacePurpose.Work)
                     : OnStartTrip.InvokeAsync(TripDestination.To(place))">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg>
            @label
        </button>;

    /// <summary>Why the reference stays the pick: a station that saves more is past the longest detour, it's the only one, or none saves enough.</summary>
    private string PickIsReferenceWhy(TripPlan plan, TripQuery query)
    {
        if (plan.Stations.Any(s => s.Id != plan.PickId && s.Reachable && s.SavesDollars >= SmallestSaving))
        {
            return L["TripWhyDetour", query.MaxDetourMinutes];
        }

        return plan.Stations.Count(s => s.Reachable) == 1
            ? L["TripWhyOnly", query.Fuel]
            : L["TripWhyNothingSaves", Money(SmallestSaving), Litres(query.FillLitres)];
    }

    /// <summary>How a station on the way compares: past the range, the reference, what it saves, or what it costs more.</summary>
    private (string? Class, string Text) Status(TripStation station, TripStation? reference, TripQuery query)
    {
        if (!station.Reachable)
        {
            return ("is-out", L["PastYourRange"]);
        }

        if (station.Id == reference?.Id)
        {
            return ("is-neutral", Trips.Plan?.ReferenceOnTheWay == true ? L["NoDetour"] : L["SmallestDetour"]);
        }

        if (station.SavesDollars >= SmallestSaving)
        {
            return station.OverDetourLimit
                ? ("is-blocked", L["SavesOverDetour", Money(station.SavesDollars), query.MaxDetourMinutes])
                : (null, L["Saves", Money(station.SavesDollars)]);
        }

        return ("is-neutral", station.SavesDollars < 0 ? L["CostsMore", Money(-station.SavesDollars)] : L["AboutTheSame"]);
    }

    private void EditRange()
    {
        _editingRange = !_editingRange;
        _rangeText = Cars.Active.RangeKm?.ToString(CultureInfo.InvariantCulture) ?? "";
    }

    /// <summary>The range typed: saved on the car with the time, which plans the trip again.</summary>
    private async Task SaveRangeAsync()
    {
        if (!int.TryParse(_rangeText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var km) || km < 0)
        {
            return;
        }

        _editingRange = false;
        await Cars.SetRangeAsync(Math.Min(km, CarProfile.MaxRangeKm), Time.GetUtcNow());
    }

    /// <summary>When the range was typed: the time today, the day before that.</summary>
    private string RangeTime(DateTimeOffset at)
    {
        var local = TimeZoneInfo.ConvertTime(at, TimeZoneInfo.Local);
        var today = TimeZoneInfo.ConvertTime(Time.GetUtcNow(), TimeZoneInfo.Local).Date;
        return local.Date == today
            ? Formatting.TimeOfDay(at, TimeZoneInfo.Local, CultureInfo.CurrentCulture)
            : local.ToString("M", CultureInfo.CurrentCulture);
    }

    private string TripTitle(TripDestination destination) => destination.Kind switch
    {
        PlaceKind.Home => L["TripToHome"],
        PlaceKind.Work => L["TripToWork"],
        PlaceKind.Other => L["TripToPlace", destination.Name ?? ""],
        _ => destination.Address is { } address ? L["TripToPlace", address] : L["TripToPin"],
    };

    private static string DestinationIcon(TripDestination destination) => destination.Kind switch
    {
        PlaceKind.Home => Icons.Home,
        PlaceKind.Work => Icons.Work,
        _ => Icons.Place,
    };

    /// <summary>The saved place the trip goes to, if it's still saved.</summary>
    private SavedPlace? SavedPlaceOf(TripDestination destination) =>
        destination.Kind is null
            ? null
            : Places.Places.FirstOrDefault(p => p.Kind == destination.Kind && p.Latitude == destination.Latitude && p.Longitude == destination.Longitude);

    private static bool IsOnTheWay(TripStation station) => station.DetourKm <= NoDetourKm && station.DetourMin <= NoDetourMinutes;

    /// <summary>"No detour", or "+5 min · 4.0 km detour".</summary>
    private string Detour(TripStation station) =>
        IsOnTheWay(station) ? L["NoDetour"] : L["DetourMinutesKm", Math.Round(station.DetourMin), Distance(station.DetourKm)];

    /// <summary>A tile's line under the name: where along the route, and the detour when there's one.</summary>
    private string TripSub(TripStation station)
    {
        string km = L["KmAlong", Math.Round(station.KmAlong)];
        return IsOnTheWay(station) ? km : $"{km} · {L["DetourMinutesShort", Math.Round(station.DetourMin)]}";
    }

    private static TripStation? TripFind(TripPlan plan, long? id) => id is null ? null : plan.Stations.FirstOrDefault(s => s.Id == id);

    /// <summary>
    /// Other stations that save, besides the pick: those that could be picked first, then those past the longest detour or
    /// whose saving is uncertain, each lowest cost first.
    /// </summary>
    private static List<RankedStation> Others(BestNearby result, RankedStation pick) =>
        result.Stations
            .Where(s => s.Id != pick.Id && s.SavesDollars >= SmallestSaving)
            .OrderBy(s => s.OverDetourLimit || s.SavingUncertain)
            .ThenBy(s => s.CostDollars)
            .Take(MaxOthers)
            .ToList();

    private static RankedStation? Find(BestNearby result, long? id) => result.Stations.FirstOrDefault(s => s.Id == id);

    /// <param name="note">A last line, for what makes the station stand out: what it saves, or that it's past the longest detour.</param>
    private RenderFragment Tile(string label, long id, string? brand, decimal priceCents, bool highlighted, string sub, string? note = null) =>
        @<button type="button" class="tile @(highlighted ? "is-on" : null)" @onclick="() => OnOpenStation.InvokeAsync(id)">
            <span class="label">@label</span>
            <span class="name">@($"{NameOf(brand)} {Price(priceCents)}")</span>
            <span class="sub">@sub</span>
            @if (note is not null)
            {
                <span class="note">@note</span>
            }
        </button>;

    /// <summary>A near-you tile's line under the name: the distance and the fill-up's cost.</summary>
    private string NearSub(RankedStation station) => $"{Distance(station.DistanceKm)} · {Money(station.CostDollars)}";

    /// <summary>What the savings were worked out for: the car, and Costco when it's counted.</summary>
    private string CarFooter(decimal fillLitres, decimal litresPer100Km, bool costcoMember)
    {
        string car = Cars.IsTypical
            ? L["FooterTypicalCar", Litres(fillLitres), Litres(litresPer100Km)]
            : L["FooterCar", Litres(fillLitres), Litres(litresPer100Km), CarName];
        return costcoMember ? $"{car} {L["FooterCostco"]}" : car;
    }

    private static RenderFragment Logo(string? brand, string cssClass)
    {
        var style = BrandCatalog.For(brand);
        return @<span class="@cssClass @(style.Monogram.Length > 1 ? "is-wide" : null)" style="--logo-bg: @style.Background; --logo-fg: @style.Foreground">
            @if (style.LogoUrl is { } logoUrl)
            {
                <img src="@logoUrl" alt="" />
            }
            else
            {
                @style.Monogram
            }
        </span>;
    }

    private string NameOf(string? brand) => BrandCatalog.For(brand).Name ?? L["Independent"];

    private string Distance(double km)
    {
        var value = Formatting.Km(km, CultureInfo.CurrentCulture);
        return Trip || Best.Result?.ByRoad == true ? L["DistanceByRoad", value] : L["DistanceApprox", value];
    }

    /// <summary>How far a station is, and by road how long it takes to get there.</summary>
    private string Away(RankedStation station) =>
        station.DurationMin is { } minutes
            ? $"{Distance(station.DistanceKm)} · {Formatting.Duration(minutes, CultureInfo.CurrentCulture)}"
            : Distance(station.DistanceKm);

    private static string Price(decimal priceCents) => Formatting.Price(priceCents, CultureInfo.CurrentCulture);

    private static string Money(decimal dollars) => Formatting.Money(dollars, CultureInfo.CurrentCulture);

    private static string Litres(decimal litres) => litres.ToString("0.##", CultureInfo.CurrentCulture);

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Best.Changed -= OnChanged;
        Cars.Changed -= OnChanged;
        Trips.Changed -= OnChanged;
        Places.Changed -= OnChanged;
        Services.Changed -= OnChanged;
    }
}
