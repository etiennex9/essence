@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Strings> L

@* The warning a Go link gives when its station closes soon after the driver gets there, or is closed then (GoLink): "Costco
   closes at 9:30 p.m. You'd get there around 9:22 p.m.", then Cancel or Go anyway. Go anyway is the real link, opened by
   the browser as any link (so a popup blocker lets it through, and Android hands it to Google Maps), and it closes the
   dialog behind it. A native modal dialog opened from JS (essenceDialog.js, as About's): Esc, Android's Back and a click
   outside close it too. *@
<dialog class="closing" @ref="_dialog" aria-labelledby="@_titleId" aria-describedby="@_textId" closedby="any" @onclose="OnClosed">
    <h2 id="@_titleId">@Title</h2>
    <div id="@_textId">
        @foreach (var line in Lines)
        {
            <p>@line</p>
        }
    </div>
    <div class="buttons">
        <button type="button" class="cancel" @onclick="CloseAsync">@L["Cancel"]</button>
        <a class="anyway" href="@Href" target="_blank" rel="noopener" @onclick="CloseAsync">@L["GoAnyway"]</a>
    </div>
</dialog>

@code {
    private const string ModulePath = "./_content/Essence.UI/js/essenceDialog.js";

    private static int _count;

    private readonly string _titleId;
    private readonly string _textId;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private bool _open;
    private bool _disposed;

    public ClosingDialog()
    {
        var n = Interlocked.Increment(ref _count);
        (_titleId, _textId) = ($"ess-closing-title-{n}", $"ess-closing-text-{n}");
    }

    /// <summary>"Costco closes at 9:30 p.m.", "Costco is closed".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>"You'd get there around 9:22 p.m.", and when it opens again.</summary>
    [Parameter]
    public IReadOnlyList<string> Lines { get; set; } = [];

    /// <summary>Where Go anyway goes: Google Maps' directions.</summary>
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    public async Task ShowAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _instance ??= await _module.InvokeAsync<IJSObjectReference>("attachModal", _dialog);
            if (_disposed)
            {
                await DetachAsync();
                return;
            }

            _open = true;
            await _instance.InvokeVoidAsync("open");
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }
    }

    private async Task CloseAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("close");
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the dialog goes with it.
        }
    }

    private void OnClosed() => _open = false;

    /// <summary>Back or a link while it's open: it goes with the page it was on.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_open)
        {
            _ = InvokeAsync(CloseAsync);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        await DetachAsync();
    }

    private async ValueTask DetachAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
                _instance = null;
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
                _module = null;
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }
    }
}
