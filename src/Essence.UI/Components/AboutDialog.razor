@implements IAsyncDisposable
@inject ReleaseNotes Notes
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Strings> L

@* The app's version and what changed in each version, newest first; older months load as the list scrolls. A native
   modal dialog, always rendered and opened from JS (essenceDialog.js): Esc, Android's Back, a click outside and Close all
   close it. *@
<dialog class="about" @ref="_dialog" aria-labelledby="ess-about-title" closedby="any" @onclose="OnClosed">
    <header>
        <h2 id="ess-about-title">@L["About"]</h2>
        <button type="button" class="icon-button" @onclick="CloseAsync" aria-label="@L["Close"]" title="@L["Close"]">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round"><path d="@Icons.Close" /></svg>
        </button>
    </header>

    <div class="body" @ref="_body">
        @if (Notes.State is ReleaseState.NotLoaded or ReleaseState.Loading)
        {
            <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
        }
        else if (Notes.State == ReleaseState.Failed)
        {
            <p class="message">
                @L["ChangelogFailed"]
                <button type="button" class="link" @onclick="RetryAsync">@L["Retry"]</button>
            </p>
        }
        else
        {
            <p class="version">
                @if (Notes.Release is { Version: { } current } release)
                {
                    @L["VersionLabel", ReleaseNotes.VersionName(current)]
                    @if (release.Commit is { } commit)
                    {
                        <span class="commit"> · @commit</span>
                    }
                }
                else
                {
                    @L["DevelopmentVersion"]
                }
            </p>

            <h3>@L["WhatsNew"]</h3>
            @if (Notes.Release is { Unreleased.Count: > 0 } unreleased)
            {
                <section>
                    <h4>@L["NotReleasedYet"]</h4>
                    <ul>
                        @foreach (var change in unreleased.Unreleased)
                        {
                            <li>@ReleaseNotes.TextOf(change, CultureInfo.CurrentUICulture)</li>
                        }
                    </ul>
                </section>
            }

            @foreach (var version in Notes.Versions)
            {
                <section @key="version.Date">
                    <h4>@ReleaseNotes.DateHeading(version.Date, L["ChangelogDateFormat"], L["ChangelogDateFormatFirstDay"], CultureInfo.CurrentUICulture)</h4>
                    <ul>
                        @foreach (var change in version.Changes)
                        {
                            <li>@ReleaseNotes.TextOf(change, CultureInfo.CurrentUICulture)</li>
                        }
                    </ul>
                </section>
            }

            @if (Notes.LoadingMonth && Notes.Versions.Count == 0)
            {
                <div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
            }
            else if (Notes.MonthFailed && !Notes.LoadingMonth)
            {
                <p class="message">
                    @L["ChangelogFailed"]
                    <button type="button" class="link" @onclick="LoadMore">@L["Retry"]</button>
                </p>
            }
            else if (!Notes.HasMore && Notes.Versions.Count == 0 && Notes.Release is not { Unreleased.Count: > 0 })
            {
                <p class="message">@L["ChangelogEmpty"]</p>
            }
        }

        @* Stays in the DOM for the observer, and shown while a month loads so it keeps the keyboard's focus; hidden once no
           month is left. Pressed for the user as it scrolls into view. *@
        <button type="button" class="older" @ref="_more" hidden="@(!ShowMore)" aria-busy="@(Notes.LoadingMonth ? "true" : "false")"
                @onclick="LoadMore">@L["OlderVersions"]</button>
    </div>
</dialog>

@code {
    private const string ModulePath = "./_content/Essence.UI/js/essenceDialog.js";

    private ElementReference _dialog;
    private ElementReference _body;
    private ElementReference _more;
    private Task<IJSObjectReference?>? _attach;
    private IJSObjectReference? _module;
    private IJSObjectReference? _instance;
    private DotNetObjectReference<AboutDialog>? _self;
    private bool _open;
    private bool _disposed;

    private bool ShowMore => Notes.State == ReleaseState.Loaded && Notes.HasMore && (Notes.LoadingMonth || !Notes.MonthFailed);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _attach = AttachAsync();
            await _attach;
        }
        else if (_open && _instance is not null)
        {
            await _instance.InvokeVoidAsync("refresh");
        }
    }

    public async Task ShowAsync()
    {
        if (_attach is null || await _attach is not { } instance)
        {
            return;
        }

        _open = true;
        await instance.InvokeVoidAsync("open");
        StateHasChanged();
        await Notes.LoadReleaseAsync();
        StateHasChanged();
        // The newest month; the next ones load as the list scrolls (or as soon as this one leaves room for more).
        if (Notes.Versions.Count == 0)
        {
            await LoadMore();
        }
    }

    /// <summary>Called by essenceDialog.js as the Older versions button nears the view, and by the button itself.</summary>
    [JSInvokable]
    public async Task LoadMore()
    {
        // Already on its way: rendering again would only ask for it again after the render.
        if (Notes.LoadingMonth)
        {
            return;
        }

        var load = Notes.LoadMoreAsync();
        StateHasChanged();
        await load;
        StateHasChanged();
    }

    private async Task RetryAsync()
    {
        await Notes.LoadReleaseAsync();
        StateHasChanged();
        await LoadMore();
    }

    private async Task CloseAsync()
    {
        if (_instance is not null)
        {
            await _instance.InvokeVoidAsync("close");
        }
    }

    private void OnClosed() => _open = false;

    /// <summary>Back or a link while the dialog is open (iOS's swipe has no close request): it goes with the page it was on.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_open)
        {
            _ = InvokeAsync(CloseAsync);
        }
    }

    private async Task<IJSObjectReference?> AttachAsync()
    {
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _instance = await _module.InvokeAsync<IJSObjectReference>("attachDialog", _dialog, _body, _more, _self);
        if (_disposed)
        {
            // Gone while the module was loading.
            await DetachAsync();
        }

        return _instance;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        await DetachAsync();
    }

    private async ValueTask DetachAsync()
    {
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
                _instance = null;
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
                _module = null;
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; the dialog goes with it.
        }

        _self?.Dispose();
    }
}
