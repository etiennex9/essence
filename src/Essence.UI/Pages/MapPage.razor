    /// <summary>
    /// Fetches the stations around the viewport. A newer call cancels an older one still in flight, and the same request
    /// isn't repeated while it's in flight or fresh (map events often report the same view twice). Each success plans a
    /// <paramref name="background"/> refresh of the same view for when the next prices should be in; that one fetches
    /// even if fresh, shows no progress, and fails silently.
    /// </summary>
    private async Task LoadAsync(Viewport viewport, bool background = false)
    {
        if (!StationViewport.ShouldFetch(viewport))
        {
            _retryCts?.Cancel();
            _loadCts?.Cancel();
            CancelRefresh();
            _lastFetch = null;
            _loading = false;
            _loadError = ApiError.None;
            StateHasChanged();
            return;
        }

        var fuel = _fuel;
        var radiusKm = StationViewport.FetchRadiusKm(viewport);
        var key = StationViewport.FetchKey(fuel, viewport);
        if (!background && _lastFetch is { } last && last.Key == key && DateTimeOffset.UtcNow - last.At < FetchFreshness)
        {
            return;
        }

        // Planned again once this one is in.
        _retryCts?.Cancel();
        _loadCts?.Cancel();
        CancelRefresh();
        var cts = _loadCts = new CancellationTokenSource();
        _lastFetch = (key, DateTimeOffset.UtcNow);
        if (!background)
        {
            _loading = true;
            StateHasChanged();
        }

        ApiResult<List<NearbyStation>> result;
        try
        {
            result = await Api.GetNearbyAsync(viewport.CenterLat, viewport.CenterLon, radiusKm, fuel, StationViewport.FetchLimit, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || fuel != _fuel)
        {
            return;
        }

        if (background && result.Value is null)
        {
            // The prices shown stay; the next refresh tries again.
            _lastFetch = null;
            _lateRefreshes++;
            ScheduleRefresh(result.Error == ApiError.RateLimited ? result.RetryAfter : null);
            return;
        }

        _loading = false;
        _loadError = result.Error;
        if (result.Value is { } stations)
        {
            _loaded = true;
            _lateRefreshes = background && result.DataAsOf == _dataAsOf ? _lateRefreshes + 1 : 0;
            _dataAsOf = result.DataAsOf;
            _stations.Merge(stations, viewport.Center);
            await RenderMarkersAsync();
            ScheduleRefresh();
        }
        else
        {
            _lastFetch = null;
            _retryDelay = result.Error == ApiError.RateLimited ? result.RetryAfter ?? FailedRetryDelay : FailedRetryDelay;
            _ = RetryLaterAsync(_retryDelay, (_retryCts = new CancellationTokenSource()).Token);
        }

        StateHasChanged();
    }

    private async Task RetryLaterAsync(TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_viewport is { } viewport)
        {
            await InvokeAsync(() => LoadAsync(viewport));
        }
    }

    /// <summary>Plans the next background refresh: by default timed to the next import, later while it's late.</summary>
    private void ScheduleRefresh(TimeSpan? delay = null)
    {
        // The real clock rather than the app's TimeProvider: it's timed against the server's Last-Modified, which the
        // simulated time of Development (?now=) would put hours or days away.
        var now = DateTimeOffset.UtcNow;
        _refreshDueAt = now + (delay ?? RefreshSchedule.Next(_dataAsOf, now, _lateRefreshes));
        StartRefreshTimer();
    }

    /// <summary>Waits for the planned refresh, unless the page is hidden. One that's overdue runs at once.</summary>
    private void StartRefreshTimer()
    {
        _refreshCts?.Cancel();
        if (_hidden || _refreshDueAt is not { } dueAt)
        {
            return;
        }

        var cts = _refreshCts = new CancellationTokenSource();
        _ = RefreshLaterAsync(dueAt - DateTimeOffset.UtcNow, cts.Token);
    }

    private async Task RefreshLaterAsync(TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay > TimeSpan.Zero ? delay : TimeSpan.Zero, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() => !cancellationToken.IsCancellationRequested && _viewport is { } viewport
            ? LoadAsync(viewport, background: true)
            : Task.CompletedTask);
    }

    private void CancelRefresh()
    {
        _refreshCts?.Cancel();
        _refreshDueAt = null;
    }

    public Task OnVisibilityChangedAsync(bool visible)
    {
        Updates.SetVisible(visible);
        Best.SetVisible(visible);
        _hidden = !visible;
        if (_hidden)
        {
            _refreshCts?.Cancel();
        }
        else
        {
            StartRefreshTimer();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Reloads the page for a new release: asked for by the user, or <paramref name="automatic"/> while the page is away or
    /// just back (<see cref="UpdateCheck"/>). Once the map is placed, the page reopens as it is; before that, it starts over.
    /// An automatic reload that can't save the view doesn't happen: the offer to reload stays.
    /// </summary>
    private async Task ReloadAsync(bool automatic)
    {
        if (_mapReady)
        {
            await _map!.ReloadAsync(
                new ReloadState(
                    _fuel, _stationPushed, _listPushed, _carsPushed, _tripPushed, _carsOverTrip, _placesPushed, Best.SelectedId),
                saveView: _placed, automatic);
        }
    }

    private async Task RenderMarkersAsync()
    {
        if (!_mapReady || _viewport is null)
        {
            return;
        }

        var visible = _stations.Visible(_viewport);
        _visibleCount = visible.Count;
        var emphasis = MapEmphasisNow();
        var now = Time.GetUtcNow();
        _nextHoursChange = null;
        List<(MarkerModel Marker, decimal? PriceCents)> markers =
            [.. visible.Select(v => (ToMarker(v, emphasis, now), v.HasPrice ? v.Price!.PriceCents : null))];

        // A ranked station 9 km away, or one along a trip zoomed out, is usually not among the stations fetched around the
        // view, which setMarkers would drop. Its hours are the cached station's, when it was fetched before.
        var shown = markers.Select(m => m.Marker.Id).ToHashSet();
        var prices = visible.Where(v => v.HasPrice).Select(v => v.Price!.PriceCents!.Value).Order().ToList();
        if (MapBest is { } best)
        {
            markers.AddRange(best.Stations.Where(s => shown.Add(s.Id)).Select(s =>
                (ToMarker(s.Id, s.Brand, s.Address, s.Latitude, s.Longitude, s.PriceCents, emphasis, prices, now), (decimal?)s.PriceCents)));
        }

        if (MapTrip is { } trip)
        {
            markers.AddRange(trip.Stations.Where(s => shown.Add(s.Id)).Select(s =>
                (ToMarker(s.Id, s.Brand, s.Address, s.Latitude, s.Longitude, s.PriceCents, emphasis, prices, now), (decimal?)s.PriceCents)));
        }

        await SetEmphasisAsync(emphasis);
        await _map!.SetMarkersAsync(Placed(markers, emphasis));
        ScheduleHoursRender(_nextHoursChange, now);
    }

    /// <summary>
    /// One render of the markers when the first station drawn opens or closes, so its pill turns grey, or back, on time;
    /// each render plans it again. A planned one for the same moment is kept.
    /// </summary>
    private void ScheduleHoursRender(DateTimeOffset? changeAt, DateTimeOffset now)
    {
        if (changeAt == _hoursChangeAt || _disposed)
        {
            return;
        }

        _hoursTimer?.Dispose();
        _hoursTimer = null;
        _hoursChangeAt = changeAt;
        if (changeAt is not { } at)
        {
            return;
        }

        // A second past the change, so it's surely past it then.
        var due = at - now + TimeSpan.FromSeconds(1);
        _hoursTimer = Time.CreateTimer(
            _ => InvokeAsync(() =>
            {
                _hoursChangeAt = null;
                return _disposed ? Task.CompletedTask : RenderMarkersAsync();
            }),
            null, due > TimeSpan.Zero ? due : TimeSpan.Zero, Timeout.InfiniteTimeSpan);
    }

    /// <summary>
    /// Which marker draws on top, and from which zoom each has room for its price (<see cref="PillPlacement"/>): the station
    /// ringed and the flagged ones first, then the cheapest, the faded ones after those listed.
    /// </summary>
    private List<MarkerModel> Placed(List<(MarkerModel Marker, decimal? PriceCents)> markers, MapEmphasis? emphasis)
    {
        // Faded as essenceMap.js's applyEmphasis fades them.
        var selected = MapSelected;
        var listed = emphasis?.Listed.ToHashSet();
        string? FlagOf(long id) => id == emphasis?.PickId ? L["BestValue"] : id == emphasis?.SecondId ? emphasis.SecondFlag : null;
        var places = PillPlacement.Place(
            [.. markers.Select(m => new PillCandidate(
                m.Marker.Id, m.Marker.Lat, m.Marker.Lon, m.PriceCents, m.Marker.Favorite,
                Dimmed: listed is not null && !listed.Contains(m.Marker.Id) && m.Marker.Id != selected,
                Selected: m.Marker.Id == selected,
                Pick: m.Marker.Id == emphasis?.PickId,
                Second: m.Marker.Id == emphasis?.SecondId,
                Flag: FlagOf(m.Marker.Id),
                Closed: m.Marker.Closed))],
            MapLabels());
        return [.. markers.Select(m => m.Marker with { Z = places[m.Marker.Id].Z, PillFrom = places[m.Marker.Id].PillFrom })];
    }

    /// <summary>What the map draws over the stations: the trip's destination and where its range runs out, and the pin.</summary>
    private List<PillObstacle> MapLabels()
    {
        List<PillObstacle> labels = [];
        if (TripMode && Trips.Destination is { } destination)
        {
            labels.Add(PillObstacle.Label(destination.Point, DestinationLabel(destination)));
        }

        if (MapTrip is { } plan && RangeEnd(plan) is { } rangeEnd)
        {
            labels.Add(PillObstacle.Label(rangeEnd, L["RangeEndsAt", Math.Round(plan.StopBeforeKm ?? 0)]));
        }

        if (MapPin is { } pin)
        {
            labels.Add(PillObstacle.Pin(pin));
        }

        return labels;
    }

    /// <summary>Where the trip's range runs out along its route, when it does before the end (<see cref="TripPath.Split"/>).</summary>
    private GeoPoint? RangeEnd(TripPlan plan)
    {
        if (!ReferenceEquals(plan, _rangeEnd.Plan))
        {
            _rangeEnd = (plan, plan.StopBeforeKm > 0 ? TripPath.Split(plan.Path, plan.DistanceKm, plan.StopBeforeKm).At : null);
        }

        return _rangeEnd.At;
    }

    /// <summary>
    /// What stands out on the map: Best near you's pick and closest, or the trip's pick and reference (on the way, or the
    /// smallest detour), each flagged; the stations they don't list fade.
    /// </summary>
    /// <param name="SecondMarkerKey">The string that names the second station in its marker's label.</param>
    private sealed record MapEmphasis(long? PickId, long? SecondId, IReadOnlyList<long> Listed, string SecondFlag, string SecondMarkerKey);

    private MapEmphasis? MapEmphasisNow()
    {
        if (MapTrip is { } trip)
        {
            // The stations worth stopping at stand out along the route; the rest (out of range, or saving nothing) fade.
            long?[] named = [trip.PickId, trip.ReferenceId, trip.BiggestSavingId];
            return new MapEmphasis(
                trip.PickId, trip.ReferenceId,
                [.. trip.Stations
                    .Where(s => named.Contains(s.Id) || (s.Reachable && s.SavesDollars >= StationChoice.SmallestSaving))
                    .Select(s => s.Id)],
                trip.ReferenceOnTheWay ? L["NoDetour"] : L["SmallestDetour"], trip.ReferenceOnTheWay ? "MarkerNoDetour" : "MarkerSmallestDetour");
        }

        return MapBest is { } best
            ? new MapEmphasis(best.Pick?.Id, best.ClosestId, [.. best.Stations.Select(s => s.Id)], L["Closest"], "MarkerClosest")
            : null;
    }

    /// <summary>
    /// The pin on the map: one just dropped, with its card; else the one Best near you ranks from ("Near here"), while its
    /// pane is open.
    /// </summary>
    private GeoPoint? MapPin => _pin ?? (BestOpen && Best.Origin is { Kind: OriginKind.Pin } origin ? origin.Point : null);

    /// <summary>Shows <see cref="MapPin"/> on the map when it changed, and says so: the prices must then make room for it.</summary>
    private async Task<bool> SyncPinAsync()
    {
        var pin = MapPin;
        if (!_mapReady || pin == _mapPin)
        {
            return false;
        }

        _mapPin = pin;
        await _map!.SetPinAsync(pin);
        return true;
    }

    /// <summary>Rings <see cref="MapSelected"/> on the map, when it changed.</summary>
    private async Task SyncSelectedAsync()
    {
        var selected = MapSelected;
        if (!_mapReady || selected == _mapSelected)
        {
            return;
        }

        _mapSelected = selected;
        await _map!.SetSelectedAsync(selected);
    }

    /// <summary>
    /// A station chosen in Best near you or on the way: it's ringed, and panned out from under the pane if it's under it.
    /// The map isn't fitted again, so the route or the pick stay in view.
    /// </summary>
    private async Task ShowSelectedAsync(GeoPoint point)
    {
        await SyncSelectedAsync();
        if (_mapReady)
        {
            await _map!.EnsureVisibleAsync(point, waitForPane: false);
        }
    }

    /// <summary>The emphasis is sent again only when it changes.</summary>
    private async Task SetEmphasisAsync(MapEmphasis? emphasis)
    {
        var key = emphasis is null
            ? null
            : $"{emphasis.PickId}|{emphasis.SecondId}|{emphasis.SecondFlag}|{string.Join(',', emphasis.Listed)}";
        if (key == _emphasis)
        {
            return;
        }

        _emphasis = key;
        await _map!.SetEmphasisAsync(emphasis?.PickId, emphasis?.SecondId, emphasis?.Listed, L["BestValue"], emphasis?.SecondFlag ?? L["Closest"]);
    }

    private MarkerModel ToMarker(VisibleStation visible, MapEmphasis? emphasis, DateTimeOffset now)
    {
        var station = visible.Station;
        var brand = BrandCatalog.For(station.Brand);
        var name = $"{brand.Name ?? L["Independent"]}, {station.Address}";
        var price = Formatting.Price(visible.HasPrice ? visible.Price!.PriceCents : null, CultureInfo.CurrentCulture);
        string label = visible.HasPrice ? L["MarkerPrice", name, price] : L["MarkerUnavailable", name, _fuel];
        var favorite = Favorites.IsFavorite(station.Id);
        var closed = IsClosed(station.Id, station.Hours, station.Latitude, station.Longitude, now);
        return new MarkerModel(
            station.Id, station.Latitude, station.Longitude, Label(label, station.Id, favorite, emphasis, closed), price, !visible.HasPrice,
            ToneName(visible.Tone), 0, favorite, brand.Monogram, brand.Background, brand.Foreground, brand.LogoUrl, Closed: closed);
    }

    /// <summary>A station Best near you ranked, or one along the trip, drawn even though it's not among the stations fetched around the view.</summary>
    private MarkerModel ToMarker(
        long id, string? brandName, string address, double latitude, double longitude, decimal priceCents, MapEmphasis? emphasis,
        IReadOnlyList<decimal> visiblePrices, DateTimeOffset now)
    {
        var brand = BrandCatalog.For(brandName);
        var price = Formatting.Price(priceCents, CultureInfo.CurrentCulture);
        string label = L["MarkerPrice", $"{brand.Name ?? L["Independent"]}, {address}", price];
        var favorite = Favorites.IsFavorite(id);
        var tone = StationViewport.ToneOf(priceCents, visiblePrices);
        var closed = IsClosed(id, _stations.Find(id)?.Hours, latitude, longitude, now);
        return new MarkerModel(
            id, latitude, longitude, Label(label, id, favorite, emphasis, closed), price, false, ToneName(tone), 0, favorite,
            brand.Monogram, brand.Background, brand.Foreground, brand.LogoUrl, Closed: closed);
    }

    /// <summary>
    /// Its hours say it's closed now, or its source that it's closed for now: its marker is grey. When that changes counts
    /// toward the next render of the markers (<see cref="_nextHoursChange"/>).
    /// </summary>
    private bool IsClosed(long id, Essence.Contracts.StationHours? hours, double latitude, double longitude, DateTimeOffset now)
    {
        var (closed, changesAt) = StationHoursView.MarkerAt(HoursViews.HoursOf(id, hours), latitude, longitude, now);
        if (changesAt is { } at && !(_nextHoursChange <= at))
        {
            _nextHoursChange = at;
        }

        return closed;
    }

    /// <summary>
    /// A marker's label, with what makes its station stand out: closed, a favorite, the pick, or the closest (the trip's
    /// reference).
    /// </summary>
    private string Label(string label, long id, bool favorite, MapEmphasis? emphasis, bool closed)
    {
        if (closed)
        {
            label = L["MarkerClosed", label];
        }

        if (favorite)
        {
            label = L["MarkerFavorite", label];
        }

        if (emphasis?.PickId == id)
        {
            label = L["MarkerBest", label];
        }

        if (emphasis?.SecondId == id)
        {
            label = L[emphasis.SecondMarkerKey, label];
        }

        return label;
    }

    private static string ToneName(PriceTone tone) => tone switch
    {
        PriceTone.Low => "low",
        PriceTone.Mid => "mid",
        PriceTone.High => "high",
        _ => "",
    };

    /// <summary>
    /// With Best near you open, fits the map to where the user is, the pick and the closest, beside the pane: when it opens
    /// and when they change, not when the same answer is refreshed.
    /// </summary>
    private async Task FitToBestAsync()
    {
        if (!_mapReady || View != BestView || Station is not null || MapBest is not { Pick: { } pick } best
            || Best.Origin is not { } origin)
        {
            return;
        }

        var fitted = (origin.Point, pick.Id, best.ClosestId);
        if (_fitted == fitted)
        {
            return;
        }

        _fitted = fitted;
        if (_keepView)
        {
            _keepView = false;
            return;
        }

        List<GeoPoint> points = [origin.Point, new(pick.Latitude, pick.Longitude)];
        points.AddRange(best.Stations.Where(s => s.Id == best.ClosestId).Select(s => new GeoPoint(s.Latitude, s.Longitude)));
        await _map!.FitBoundsAsync(
            points.Min(p => p.Longitude), points.Min(p => p.Latitude), points.Max(p => p.Longitude), points.Max(p => p.Latitude),
            waitForPane: true, flags: [.. points.Skip(1).Select(p => p.Latitude)], labels: []);
    }

    /// <summary>
    /// Draws the trip in trip mode: its route (dashed past where the range runs out), its destination and where the range
    /// ends. Nothing otherwise.
    /// </summary>
    private async Task RenderTripAsync()
    {
        if (!_mapReady)
        {
            return;
        }

        var plan = MapTrip;
        var destination = TripMode ? Trips.Destination : null;
        if (ReferenceEquals(plan, _drawnTrip.Plan) && destination == _drawnTrip.Destination)
        {
            return;
        }

        _drawnTrip = (plan, destination);
        await _map!.SetDestinationAsync(destination?.Point, destination is null ? "" : DestinationLabel(destination));
        if (plan is null)
        {
            await _map.ClearRouteAsync();
            await _map.SetRangeEndAsync(null, "");
            return;
        }

        var (reached, beyond, rangeEnd) = TripPath.Split(plan.Path, plan.DistanceKm, plan.StopBeforeKm);
        await _map.SetRouteAsync(reached, beyond, TripCorridor.Polygons(reached, plan.HalfWidthKm * 1000));
        await _map.SetRangeEndAsync(plan.StopBeforeKm > 0 ? rangeEnd : null, L["RangeEndsAt", Math.Round(plan.StopBeforeKm ?? 0)]);
    }

    private string DestinationLabel(TripDestination destination) => destination.Kind switch
    {
        PlaceKind.Home => L["Home"],
        PlaceKind.Work => L["Work"],
        PlaceKind.Other => destination.Name ?? "",
        _ => destination.Address ?? L["DroppedPin"],
    };

    /// <summary>
    /// In Best on the way, fits the map to the route and its pick, which may lie past either end, beside the pane: when a new
    /// plan comes in, not when it's the same.
    /// </summary>
    private async Task FitToTripAsync()
    {
        if (!_mapReady || View != TripView || Station is not null || MapTrip is not { Path.Length: > 1 } plan
            || ReferenceEquals(plan, _fittedPlan))
        {
            return;
        }

        _fittedPlan = plan;
        if (_keepView)
        {
            _keepView = false;
            return;
        }

        var pick = plan.Stations.FirstOrDefault(s => s.Id == plan.PickId);
        double[][] points = pick is null ? plan.Path : [.. plan.Path, [pick.Longitude, pick.Latitude]];
        List<double> labels = [plan.Path[^1][1]];
        if (RangeEnd(plan) is { } rangeEnd)
        {
            labels.Add(rangeEnd.Latitude);
        }

        // The reference's flag too: zoomed out, it shows when its pill has room.
        List<double> flags = [.. plan.Stations.Where(s => s.Id == plan.PickId || s.Id == plan.ReferenceId).Select(s => s.Latitude)];
        await _map!.FitBoundsAsync(
            points.Min(p => p[0]), points.Min(p => p[1]), points.Max(p => p[0]), points.Max(p => p[1]), waitForPane: true,
            flags: flags, labels: labels);
    }

    /// <summary>A press and hold on the map: a pin drops there, with its card.</summary>
    public async Task OnMapHeldAsync(double latitude, double longitude)
    {
        _pin = new GeoPoint(latitude, longitude);
        if (await SyncPinAsync())
        {
            await RenderMarkersAsync();
        }

        StateHasChanged();
    }

    private async Task ClearPinAsync()
    {
        _pin = null;
        if (await SyncPinAsync())
        {
            await RenderMarkersAsync();
        }

        StateHasChanged();
    }

    /// <summary>
    /// "Near here" on a pin's card: Best near you ranks from the pin, without asking for the location, and the pin stays on
    /// the map while it does. From a trip, it's Best near you again with the trip kept, as the trip's Back does.
    /// </summary>
    private async Task BestNearPinAsync(BestOrigin origin)
    {
        _pin = null;
        var ranking = Best.SetOriginAsync(origin);
        if (View == TripView)
        {
            await CloseTripAsync();
        }
        else if (View != BestView || Station is not null)
        {
            await ShowListAsync(BestView);
        }

        await ranking;
        if (await SyncPinAsync())
        {
            await RenderMarkersAsync();
        }

        StateHasChanged();
    }

    /// <summary>
    /// Opens Best on the way to a destination, planned from where the user is now: the location is asked for again (the
    /// one known may be hours old), and without it, the trip starts where Best near you ranks from, or the map's centre. A
    /// user who had Best near you rank from the map's centre or a pin starts there, without being asked again.
    /// </summary>
    private Task StartTripAsync(TripDestination destination) => StartTripAsync(destination, from: null, fromLink: false);

    /// <param name="from">A saved place to start at instead (a widget's route).</param>
    /// <param name="fromLink">Opened by a link (<see cref="To"/>): the trip takes the link's entry in the history.</param>
    private async Task StartTripAsync(TripDestination destination, SavedPlace? from, bool fromLink)
    {
        // A trip the user starts is fitted, even if a release reload kept the view of the pane it started from.
        _keepView = false;
        if (from is not null)
        {
            await ClearPinAsync();
            var startingFrom = Trips.StartAsync(from.Point, destination, fromMapCenter: true, originName: PlaceName(from));
            ShowLinkedTrip();
            await startingFrom;
            return;
        }

        if (Best.Origin is not { IsChosen: true })
        {
            await LocateAsync(moveMap: false, fallBackToMontreal: false);
        }

        var (origin, fromMapCenter) = Best.Origin is { IsMapCenter: true } && _viewport is { } center
            ? (center.Center, true)
            : Best.Origin is { Kind: OriginKind.Pin } pin
            ? (pin.Point, true)
            : _locationProblem is null && _userLocation is { } here
            ? (here, false)
            : Best.Origin is { } known ? (known.Point, known.IsChosen)
            : _viewport is { } viewport ? (viewport.Center, true)
            : (default, false);
        if (origin == default)
        {
            return;
        }

        await ClearPinAsync();

        // The trip is open once StartAsync returns its task (the plan comes after): the view can show it at once.
        var starting = Trips.StartAsync(origin, destination, fromMapCenter);
        if (fromLink)
        {
            ShowLinkedTrip();
        }
        else
        {
            await ShowTripAsync();
        }

        await starting;
    }

    /// <summary>Best on the way in the place of the link that opened it, with nothing below to go back to: as a link opened cold.</summary>
    private void ShowLinkedTrip()
    {
        (_stationPushed, _listPushed, _carsPushed, _carsOverTrip, _placesPushed, _tripPushed) = (false, false, false, false, false, false);
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["view"] = TripView, ["station"] = null, ["to"] = null, ["from"] = null, ["pick"] = null,
            }),
            replace: true);
    }

    /// <summary>How a saved place is called on the page: Home, Work, or its own name.</summary>
    private string PlaceName(SavedPlace place) => place.Kind switch
    {
        PlaceKind.Home => L["Home"],
        PlaceKind.Work => L["Work"],
        _ => string.IsNullOrEmpty(place.Name) ? place.Address ?? "" : place.Name,
    };

    /// <summary>
    /// Shows Best on the way: pushed over Best near you, so Back returns to it, and otherwise in the place of the pane
    /// open (or pushed when none is).
    /// </summary>
    private async Task ShowTripAsync()
    {
        if (View == TripView)
        {
            // The trip is under the details.
            await CloseDetailsAsync();
            return;
        }

        if (View == BestView && Station is null)
        {
            _tripPushed = true;
            Navigation.NavigateTo(
                Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = TripView, ["station"] = null }));
            return;
        }

        // Details, My cars or the address search pushed over Best near you: the trip takes their entry, over Best near you
        // all the same.
        if ((View == BestView && _stationPushed) || (View == CarsView && _carsPushed && !_carsOverTrip) || (View == PlacesView && _placesPushed))
        {
            (_stationPushed, _carsPushed, _placesPushed, _tripPushed) = (false, false, false, true);
            Navigation.NavigateTo(
                Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = TripView, ["station"] = null }),
                replace: true);
            return;
        }

        await ShowListAsync(TripView);
    }

    /// <summary>Back to Best near you, keeping the trip (Forward shows it again).</summary>
    private async Task CloseTripAsync()
    {
        if (View != TripView)
        {
            return;
        }

        if (_tripPushed)
        {
            _tripPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo(
                Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = BestView, ["station"] = null }), replace: true);
        }
    }

    /// <summary>The trip bar's Close: the trip ends, back to Best near you.</summary>
    private async Task EndTripAsync()
    {
        await Trips.EndAsync();
        await CloseTripAsync();
    }

    /// <summary>Plans the trip again from where the user is now.</summary>
    private async Task RefreshTripAsync()
    {
        await LocateAsync(moveMap: false, fallBackToMontreal: false);
        if (_locationProblem is null && _userLocation is { } here)
        {
            await Trips.RefreshAsync(here);
        }
    }

    public async Task OnMarkerClickedAsync(long id)
    {
        // On a trip, a station on the way goes on top of the trip's pane, as one chosen in its list would; another opens.
        if (View == TripView && Station is null && _bestPanel is not null && await _bestPanel.SelectFromMapAsync(id))
        {
            return;
        }

        if (Station != id)
        {
            // Switching stations replaces the entry, so Back still closes the pane instead of walking through stations.
            var replace = Station is not null;
            _stationPushed |= !replace;
            _centerOnStation = false;
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", id), replace: replace);
        }
        else if (_details is not null)
        {
            // Its details are open already: shrunk to their header, they come back, and the station out from under them.
            await _details.ShowAgainAsync();
        }
    }

    /// <summary>A station picked in a list: its details open over it, and the map flies to it.</summary>
    private void OpenListedStation(long id)
    {
        _stationPushed = true;
        _centerOnStation = true;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", id));
    }

    /// <summary>
    /// How long getting to the station takes by Best near you's or the trip's reckoning, when its details are open over that
    /// pane and it's the station shown on top (their Details): Directions warns by it when the station closes soon after.
    /// </summary>
    private double? EtaFromBest(long id) =>
        View == BestView && Best.Shown is { } shown && shown.Id == id ? shown.EtaMin
        : View == TripView && Trips.Shown is { } stop && stop.Id == id ? stop.ToMin
        : null;

    /// <summary>
    /// The details of the station Best near you or the trip shows on top: they open over the pane like a list's, but the map
    /// stays where it is (the route in view), only panning the station out from under them.
    /// </summary>
    private void OpenStationFromBest(long id)
    {
        _stationPushed = true;
        _centerOnStation = false;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", id));
    }

    /// <summary>
    /// A click on the map: on phones, the sheet open shrinks to its header so the map shows, and stays so; otherwise, or with
    /// a pin dropped, what's on top closes as on Escape.
    /// </summary>
    public async Task OnMapClickedAsync()
    {
        if (_pin is null && _map is not null && await _map.CollapsePaneAsync())
        {
            return;
        }

        await OnDismissAsync();
    }

    /// <summary>
    /// Escape, or a click on the map no sheet takes: closes what's on top, the dropped pin's card, the details, My cars or the
    /// address search, the trip (back to Best near you), else the list.
    /// </summary>
    public Task OnDismissAsync() =>
        _pin is not null ? ClearPinAsync()
        : Station is not null ? CloseDetailsAsync()
        : View == CarsView ? CloseCarsAsync()
        : View == PlacesView ? ClosePlacesAsync()
        : View == TripView ? CloseTripAsync()
        : CloseListAsync();

    private Task ToggleListAsync(string view) => View == view && Station is null ? CloseListAsync() : ShowListAsync(view);

    private async Task ShowListAsync(string view)
    {
        if (View == view)
        {
            // The list is under the details.
            await CloseDetailsAsync();
            return;
        }

        // The list takes the place of the details or of the other list, so Back still leads where it did. It counts as
        // pushed unless the entry it replaces wasn't (a link opened cold).
        var replace = Station is not null || ListOpen;
        _listPushed = !replace || _stationPushed || _listPushed;
        _stationPushed = false;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = view, ["station"] = null }),
            replace: replace);
    }

    private async Task CloseListAsync()
    {
        if (!ListOpen)
        {
            return;
        }

        if (_listPushed)
        {
            _listPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", (string?)null), replace: true);
        }
    }

    /// <summary>
    /// The pump: opens Best near you, or closes it. Opening asks for the location again, so the answer is for where the
    /// user is now; the pane shows while it's found.
    /// </summary>
    private async Task ToggleBestAsync()
    {
        if (View == BestView && Station is null)
        {
            await CloseListAsync();
            return;
        }

        if (View is TripView or PlacesView && Station is null)
        {
            await CloseAllAsync();
            return;
        }

        if (View == CarsView && Station is null)
        {
            await CloseCarsAsync();
        }
        else
        {
            await ShowListAsync(BestView);
        }

        await LocateAsync(moveMap: false, fallBackToMontreal: false);
    }

    /// <summary>Best near you ranks from the map's centre: the location is off, or approximate.</summary>
    private async Task UseMapCenterAsync()
    {
        if (_viewport is { } viewport)
        {
            await Best.SetOriginAsync(new BestOrigin(viewport.Center, OriginKind.MapCenter));
        }
    }

    /// <summary>
    /// The pump with the trip or the address search open: the whole pane closes, both history entries the page pushed with
    /// it.
    /// </summary>
    private async Task CloseAllAsync()
    {
        var (tripPushed, listPushed) = (View == PlacesView ? _placesPushed : _tripPushed, _listPushed);
        (_tripPushed, _placesPushed, _listPushed) = (false, false, false);
        if (tripPushed && listPushed)
        {
            await JS.InvokeVoidAsync("history.go", -2);
        }
        else if (!tripPushed && listPushed)
        {
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            // Best near you was opened cold (or the trip replaced another pane): the top entry becomes the map.
            Navigation.NavigateTo(
                Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = null, ["station"] = null }), replace: true);
        }
    }

    /// <summary>My cars opens over Best near you or the trip as a history entry of its own, so Back returns to the pane.</summary>
    private void ShowCars()
    {
        _carsOverTrip = View == TripView;
        _carsPushed = true;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = CarsView, ["station"] = null }));
    }

    /// <summary>The address search opens over Best near you as a history entry of its own, so Back returns to the pane.</summary>
    private void ShowPlaces(PlacePurpose purpose)
    {
        _placesPurpose = purpose;
        _placesPushed = true;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = PlacesView, ["station"] = null }));
    }

    private async Task ClosePlacesAsync()
    {
        if (View != PlacesView)
        {
            return;
        }

        if (_placesPushed)
        {
            _placesPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            // Opened cold: Best near you takes its place.
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", BestView), replace: true);
        }
    }

    /// <summary>"Pick it on the map": the panes close so the map is in reach, and the status says how.</summary>
    private async Task PickOnMapAsync()
    {
        await CloseAllAsync();
        ShowNotice(L["PickOnMapNotice"]);
    }

    private async Task CloseCarsAsync()
    {
        if (View != CarsView)
        {
            return;
        }

        if (_carsPushed)
        {
            _carsPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            // Opened cold: Best near you takes its place.
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", BestView), replace: true);
        }
    }

    private async Task CloseDetailsAsync()
    {
        if (Station is null)
        {
            return;
        }

        if (_stationPushed)
        {
            _stationPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", (long?)null), replace: true);
        }
    }

    private async Task OnStationLoadedAsync(StationDetail station)
    {
        if (_mapReady)
        {
            await ShowStationAsync(station);
        }
        else
        {
            _pendingStation = station;
        }
    }

    private async Task ShowStationAsync(StationDetail station)
    {
        _pendingStation = null;
        if (station is not { Latitude: { } lat, Longitude: { } lon })
        {
            return;
        }

        var point = new GeoPoint(lat, lon);
        if (_centerOnStation)
        {
            _centerOnStation = false;
            await _map!.FlyToAsync(point, StationZoom, waitForPane: true);
        }
        else
        {
            await _map!.EnsureVisibleAsync(point);
        }
    }

    private void ShowNotice(string message)
    {
        _noticeCts?.Cancel();
        var cts = _noticeCts = new CancellationTokenSource();
        _notice = message;
        _ = ClearNoticeAsync(cts.Token);
    }

    private async Task ClearNoticeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(NoticeDuration, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _notice = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A station starred or un-starred: its marker gains or loses the star.</summary>
    private void OnFavoritesChanged() => InvokeAsync(RenderMarkersAsync);

    /// <summary>The user corrected a station's hours, or undid it: its marker is grey or not as its hours now say.</summary>
    private void OnHoursCorrected() => InvokeAsync(RenderMarkersAsync);

    /// <summary>The toolbar shows how many stations are compared.</summary>
    private void OnComparisonChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Another release came out, or was rolled back: the offer to reload shows or goes.</summary>
    private void OnUpdateChanged() => InvokeAsync(StateHasChanged);

    private void OnAppHostChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Another release while the page is away or just back: it reloads by itself.</summary>
    private void OnReloadDue() => InvokeAsync(() => ReloadAsync(automatic: true));

    /// <summary>Trips or the search being prepared, or ready: the chip's "To work" and the pin's card follow.</summary>
    private void OnServicesChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// The routing data is ready after being prepared: trips are offered again, a trip it refused is planned, and Best near
    /// you is asked again, by road this time.
    /// </summary>
    private void OnRoutingReady() => InvokeAsync(async () =>
    {
        Trips.ClearUnavailable();
        if (Trips.IsOpen && Trips.Plan is null && Trips.Error == ApiError.Unavailable)
        {
            await Trips.RetryAsync();
        }

        if (Best.Result is { ByRoad: false })
        {
            await Best.RetryAsync();
        }

        StateHasChanged();
    });

    /// <summary>
    /// A new plan, the trip opened or ended, or another station shown on top: the map follows. A 503 asks how far the
    /// routing data is.
    /// </summary>
    private void OnTripChanged() => InvokeAsync(async () =>
    {
        if (Trips.Error == ApiError.Unavailable && !Trips.Loading)
        {
            _ = Services.RefreshAsync();
        }

        await SyncSelectedAsync();
        await RenderMarkersAsync();
        await RenderTripAsync();
        await FitToTripAsync();
        StateHasChanged();
    });

    /// <summary>Home or Work saved or forgotten: the phone chip's "To Work" follows.</summary>
    private void OnPlacesChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// A new Best near you, or another station shown on top: the map and the chip follow. Estimates while routing reads
    /// ready may mean it just stopped serving (new data, a new version): its status is asked once per answer, so the pane
    /// says how far it is and Best near you is asked again by road once it's back.
    /// </summary>
    private void OnBestChanged() => InvokeAsync(async () =>
    {
        if (Best.Result is { ByRoad: false, Pick: not null } estimate && !ReferenceEquals(estimate, _estimateChecked)
            && !Services.RoutingPreparing)
        {
            _estimateChecked = estimate;
            _ = Services.RefreshAsync();
        }

        await SyncSelectedAsync();
        await SyncPinAsync();
        await RenderMarkersAsync();
        await FitToBestAsync();
        StateHasChanged();
    });

    /// <summary>Another car picked, or its fuel changed in My cars: the map takes the car's fuel.</summary>
    private void OnCarsChanged() => InvokeAsync(async () =>
    {
        if (!Cars.IsTypical && Cars.Active.Fuel != _fuel)
        {
            await SetFuelAsync(Cars.Active.Fuel);
        }

        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _hoursTimer?.Dispose();
        Favorites.Changed -= OnFavoritesChanged;
        Overrides.Changed -= OnHoursCorrected;
        Comparison.Changed -= OnComparisonChanged;
        Updates.Changed -= OnUpdateChanged;
        Updates.ReloadDue -= OnReloadDue;
        if (_appHost is not null)
        {
            _appHost.Changed -= OnAppHostChanged;
        }

        Best.Changed -= OnBestChanged;
        Cars.Changed -= OnCarsChanged;
        Trips.Changed -= OnTripChanged;
        Places.Changed -= OnPlacesChanged;
        Services.Changed -= OnServicesChanged;
        Services.RoutingReady -= OnRoutingReady;
        _servicesWatch?.Dispose();
        Updates.Stop();
        _loadCts?.Cancel();
        _retryCts?.Cancel();
        _refreshCts?.Cancel();
        _noticeCts?.Cancel();
        if (_map is not null)
        {
            await _map.DisposeAsync();
        }
    }
}
