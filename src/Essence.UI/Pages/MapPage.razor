@page "/"
@implements IMapListener
@implements IAsyncDisposable
@inject EssenceApiClient Api
@inject FavoriteStations Favorites
@inject StationHoursOverrides Overrides
@inject StationHoursView HoursViews
@inject ComparedStations Comparison
@inject BestNearYou Best
@inject CarProfiles Cars
@inject TripState Trips
@inject SavedPlaces Places
@inject ServicesStatus Services
@inject IDeviceLocation DeviceLocation
@inject IPreferenceStore Preferences
@inject ReleaseNotes Notes
@inject UpdateCheck Updates
@inject EssenceUIOptions Options
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L
@inject IServiceProvider ServiceProvider

<PageTitle>Essence</PageTitle>

<div class="page">
    <div class="map" @ref="_mapElement" role="region" aria-label="@L["MapLabel"]"></div>

    <div class="toolbar">
        <FuelSelector Value="@_fuel" ValueChanged="SetFuelAsync" />
        <div class="tools">
            <button type="button" class="tool @(View == FavoritesView ? "is-active" : null)" @onclick="() => ToggleListAsync(FavoritesView)"
                    aria-pressed="@(View == FavoritesView ? "true" : "false")" aria-label="@L["Favorites"]" title="@L["Favorites"]">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linejoin="round"><path d="@Icons.Star" /></svg>
            </button>
            <button type="button" class="tool @(View == CompareView ? "is-active" : null)" @onclick="() => ToggleListAsync(CompareView)"
                    aria-pressed="@(View == CompareView ? "true" : "false")" aria-label="@ComparisonLabel" title="@ComparisonLabel">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Compare" /></svg>
                @if (Comparison.Count > 0)
                {
                    <span class="badge" aria-hidden="true">@Comparison.Count</span>
                }
            </button>
            <button type="button" class="tool @(PumpActive ? "is-active" : null)" @onclick="ToggleBestAsync"
                    aria-pressed="@(PumpActive ? "true" : "false")" aria-label="@L["BestNearYou"]" title="@L["BestNearYou"]">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Pump" /></svg>
            </button>
        </div>
    </div>

    <div class="status-slot">
        <UpdatePrompt Visible="@Updates.Available" OnReload="() => ReloadAsync(automatic: false)" />
        <StatusChip Message="@StatusMessage" Busy="@(_locating || _loading)" />
        @* Phones only (see the CSS), and outside the status's live region, so it isn't announced at each refresh. *@
        @if (ChipPick is { } pick)
        {
            var brand = BrandCatalog.For(pick.Brand);
            <button type="button" class="best-chip" @onclick="() => ShowListAsync(BestView)">
                <span class="logo @(brand.Monogram.Length > 1 ? "is-wide" : null)" style="--logo-bg: @brand.Background; --logo-fg: @brand.Foreground">
                    @if (brand.LogoUrl is { } logoUrl)
                    {
                        <img src="@logoUrl" alt="" />
                    }
                    else
                    {
                        @brand.Monogram
                    }
                </span>
                <span class="text">
                    <span class="kicker">
                        @L["BestChipKicker"]
                        <span class="distance">@($"· {L[Best.Result?.ByRoad == true ? "DistanceByRoad" : "DistanceApprox", Formatting.Km(pick.DistanceKm, CultureInfo.CurrentCulture)]}")</span>
                    </span>
                    <span class="name">@($"{brand.Name ?? L["Independent"]} {Formatting.Price(pick.PriceCents, CultureInfo.CurrentCulture)}")</span>
                </span>
                @if (pick.Id != Best.Result?.ReferenceId)
                {
                    <span class="saves">
                        @L["BestChipSaves", Formatting.Money(pick.SavesDollars, CultureInfo.CurrentCulture)]
                        <span>@L["BestChipVsClosest"]</span>
                    </span>
                }
                else
                {
                    <span class="saves is-neutral">@L["Closest"]</span>
                }
            </button>
            @if (Places.Work is { } work && !TripsUnavailable)
            {
                <button type="button" class="to-work" @onclick="() => StartTripAsync(TripDestination.To(work))">
                    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Work" /></svg>
                    @L["TripToWork"]
                </button>
            }
        }
    </div>

    @* Alone in the bottom-left corner (the map's own controls are bottom-right): above a bottom sheet shrunk to its header,
       under any other. *@
    <button type="button" class="tool about" @onclick="() => _about!.ShowAsync()"
            aria-label="@(_appHost?.NewerRelease is null ? L["About"] : L["AboutAppUpdate"])" title="@L["About"]">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round"><path d="@Icons.Info" /></svg>
        @if (_appHost?.NewerRelease is not null)
        {
            <span class="dot" aria-hidden="true"></span>
        }
    </button>

    @* The details open over a list (?view=…&station=…): closing them goes back to it. *@
    @if (Station is { } stationId)
    {
        <StationDetails @ref="_details" StationId="stationId" Fuel="@_fuel" UserLocation="_userLocation" DataAsOf="_dataAsOf" OnClose="CloseDetailsAsync"
                        OnLoaded="OnStationLoadedAsync" EtaMinutes="EtaFromBest(stationId)" />
    }
    else if (View == FavoritesView)
    {
        <FavoritesPanel Fuel="@_fuel" UserLocation="_userLocation" OnClose="CloseListAsync" OnOpenStation="OpenListedStation"
                        OnCompareAll="() => ShowListAsync(CompareView)" />
    }
    else if (View == CompareView)
    {
        <ComparisonPanel Fuel="@_fuel" UserLocation="_userLocation" OnClose="CloseListAsync" OnOpenStation="OpenListedStation" />
    }
    else if (View is BestView or TripView)
    {
        <BestPanel @ref="_bestPanel" Trip="@(View == TripView)" Locating="_locating" LocationProblem="_locationProblem"
                   OnClose="() => View == TripView ? CloseTripAsync() : CloseListAsync()" OnOpenStation="OpenStationFromBest"
                   OnStationSelected="ShowSelectedAsync" OnOpenCars="ShowCars"
                   OnLocate="() => LocateAsync(moveMap: false, fallBackToMontreal: false)" OnUseMapCenter="UseMapCenterAsync"
                   OnStartTrip="StartTripAsync" OnEndTrip="EndTripAsync" OnRefreshTrip="RefreshTripAsync"
                   OnSearchPlaces="ShowPlaces" />
    }
    else if (View == CarsView)
    {
        <MyCarsPanel OnClose="CloseCarsAsync" />
    }
    else if (View == PlacesView)
    {
        <PlacesPanel Purpose="_placesPurpose" UserLocation="_userLocation" MapCenter="_viewport?.Center" OnClose="ClosePlacesAsync"
                     OnStartTrip="StartTripAsync" OnSaved="_ => ClosePlacesAsync()" OnPickOnMap="PickOnMapAsync" />
    }

    @if (_pin is { } pin)
    {
        <DroppedPin Point="pin" UserLocation="_userLocation" TripsUnavailable="TripsUnavailable" OnClose="ClearPinAsync"
                    OnTrip="StartTripAsync" OnBestNear="BestNearPinAsync" />
    }

    <AboutDialog @ref="_about" />
</div>

@code {
    private const string FavoritesView = "favorites";
    private const string CompareView = "compare";
    private const string BestView = "best";

    /// <summary>My cars, pushed over Best near you or a trip.</summary>
    private const string CarsView = "cars";

    /// <summary>Best on the way, usually pushed over Best near you. No coordinates in the URL: the trip is TripState's.</summary>
    private const string TripView = "trip";

    /// <summary>The address search and the saved places, pushed over Best near you. Nothing typed goes in the URL.</summary>
    private const string PlacesView = "places";

    private const double OverviewZoom = 5.5;
    private const double UserZoom = 13;
    private const double FallbackZoom = 11;
    private const double StationZoom = 14;
    private static readonly GeoPoint Overview = new(46.6, -72.3);
    private static readonly GeoPoint Montreal = new(45.5017, -73.5673);
    private static readonly TimeSpan NoticeDuration = TimeSpan.FromSeconds(6);
    private static readonly TimeSpan FailedRetryDelay = TimeSpan.FromSeconds(15);

    /// <summary>Prices change at most every 5 minutes; an identical request within this window is skipped.</summary>
    private static readonly TimeSpan FetchFreshness = TimeSpan.FromSeconds(30);

    private readonly StationViewport _stations = new();
    private MapInterop? _map;
    private AboutDialog? _about;

    /// <summary>The <see cref="To"/> link being started (with <see cref="From"/> and <see cref="Pick"/>); null once it's out of the URL.</summary>
    private string? _linkedTo;

    /// <summary>The Android app's host, for its newer builds; null on the web.</summary>
    private IAppHost? _appHost;
    private BestPanel? _bestPanel;
    private StationDetails? _details;
    private ElementReference _mapElement;
    private string _fuel = Fuels.Default;
    private Viewport? _viewport;
    private GeoPoint? _userLocation;
    private bool _mapReady;

    /// <summary>The map is where the page means it to be at startup: on the user, a station, or a reloaded view.</summary>
    private bool _placed;
    private bool _locating;

    /// <summary>Why the location couldn't be had, the last time it was asked for.</summary>
    private LocationStatus? _locationProblem;

    private bool _loading;
    private bool _loaded;
    private int _visibleCount;
    private ApiError _loadError;
    private TimeSpan _retryDelay;
    private string? _notice;
    private (string Key, DateTimeOffset At)? _lastFetch;
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _retryCts;

    /// <summary>While the map is open, whether trips and the search are ready is followed (<see cref="ServicesStatus"/>).</summary>
    private IDisposable? _servicesWatch;

    /// <summary>The last estimate Best near you gave while routing read ready, whose status was asked again.</summary>
    private BestNearby? _estimateChecked;
    private CancellationTokenSource? _noticeCts;

    /// <summary>When the prices shown were imported, as the API says; the next refresh is timed from it.</summary>
    private DateTimeOffset? _dataAsOf;

    /// <summary>Refreshes in a row that found nothing newer, or failed.</summary>
    private int _lateRefreshes;

    private DateTimeOffset? _refreshDueAt;
    private CancellationTokenSource? _refreshCts;

    /// <summary>Draws the markers again when a station in view opens or closes (<see cref="ScheduleHoursRender"/>).</summary>
    private ITimer? _hoursTimer;

    /// <summary>When <see cref="_hoursTimer"/> fires: the earliest change among the stations drawn.</summary>
    private DateTimeOffset? _hoursChangeAt;

    /// <summary>The earliest change among the markers drawn so far in this render.</summary>
    private DateTimeOffset? _nextHoursChange;

    private bool _disposed;

    /// <summary>The page is out of sight: the refresh waits until it's back.</summary>
    private bool _hidden;

    /// <summary>Set when this page pushed the <c>?station=</c> history entry, so closing goes back instead of forward.</summary>
    private bool _stationPushed;

    /// <summary>The same for <c>?view=</c>, the list open.</summary>
    private bool _listPushed;

    /// <summary>The same for <c>?view=cars</c>, pushed over <c>?view=best</c> or <c>?view=trip</c>.</summary>
    private bool _carsPushed;

    /// <summary>My cars was opened over the trip, which the map keeps showing.</summary>
    private bool _carsOverTrip;

    /// <summary>The same as <see cref="_carsPushed"/> for <c>?view=trip</c>, pushed over <c>?view=best</c>.</summary>
    private bool _tripPushed;

    /// <summary>The same for <c>?view=places</c>, pushed over <c>?view=best</c>.</summary>
    private bool _placesPushed;

    /// <summary>What a place found in <c>?view=places</c> is for; a link opened cold searches for a trip.</summary>
    private PlacePurpose _placesPurpose;

    /// <summary>The trip the tab had open is read (TripState.LoadAsync): a <c>?view=trip</c> without one falls back.</summary>
    private bool _tripLoaded;

    /// <summary>A press and hold dropped a pin here: its card shows.</summary>
    private GeoPoint? _pin;

    /// <summary>The pin the map shows (<see cref="MapPin"/>), set again only when it changes.</summary>
    private GeoPoint? _mapPin;

    /// <summary>What the map draws of the trip (<see cref="RenderTripAsync"/>), drawn again only when it changes.</summary>
    private (TripPlan? Plan, TripDestination? Destination) _drawnTrip;

    /// <summary>The trip plan the map was last fitted to.</summary>
    private TripPlan? _fittedPlan;

    /// <summary>Where a trip plan's range runs out (<see cref="RangeEnd"/>), worked out once per plan.</summary>
    private (TripPlan? Plan, GeoPoint? At) _rangeEnd;

    /// <summary>A cold load with <c>?station=</c> centers on that station once it's loaded, instead of on the user.</summary>
    private bool _centerOnStation;

    /// <summary>What the page showed when the map last moved for it: once it shows something else, that move is forgotten.</summary>
    private (string? View, long? Station) _autoMoveFor;
    private StationDetail? _pendingStation;

    /// <summary>What the map was last fitted to for Best near you: where from, the pick and the closest.</summary>
    private (GeoPoint Origin, long Pick, long? Closest)? _fitted;

    /// <summary>A reload reopened Best near you on the view it had: the answer it gets again doesn't move the map.</summary>
    private bool _keepView;

    /// <summary>The emphasis last given to the markers (<see cref="MapInterop.SetEmphasisAsync"/>), sent again only when it changes.</summary>
    private string? _emphasis;

    /// <summary>The station last ringed on the map (<see cref="MapSelected"/>), sent again only when it changes.</summary>
    private long? _mapSelected;

    [SupplyParameterFromQuery(Name = "station")]
    public long? Station { get; set; }

    /// <summary>The list open: <c>favorites</c>, <c>compare</c>, <c>best</c>, <c>trip</c>, <c>cars</c> or <c>places</c>.</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    /// <summary>
    /// A trip to start, to a saved place: <c>home</c>, <c>work</c> or a place's id. The Android app's widget for a frequent
    /// route opens it, with <see cref="From"/> and <see cref="Pick"/>. They're dropped from the URL as the trip starts, so
    /// Back, closing the trip or a reload doesn't start it again.
    /// </summary>
    [SupplyParameterFromQuery(Name = "to")]
    public string? To { get; set; }

    /// <summary>Where a <see cref="To"/> trip starts, as <see cref="To"/> names places; without it, where the user is.</summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    /// <summary>The station a <see cref="To"/> trip shows on top: the one the widget showed, if the plan still has it on the way.</summary>
    [SupplyParameterFromQuery(Name = "pick")]
    public long? Pick { get; set; }

    private bool ListOpen => View is FavoritesView or CompareView or BestView or TripView or CarsView or PlacesView;

    /// <summary>Best near you is open, maybe under My cars, the address search or a station's details.</summary>
    private bool BestOpen => View is BestView or PlacesView || (View == CarsView && !_carsOverTrip);

    /// <summary>A trip is open in Best on the way, maybe under My cars or a station's details: the map shows it.</summary>
    private bool TripMode => Trips.IsOpen && (View == TripView || (View == CarsView && _carsOverTrip));

    /// <summary>The pump's pane is open: Best near you, Best on the way, or My cars or the address search over one of them.</summary>
    private bool PumpActive => View is BestView or TripView or CarsView or PlacesView;

    /// <summary>
    /// Trips can't be planned now: the routing data is being prepared, the routing server answered 503, or Best near you
    /// fell back to estimates.
    /// </summary>
    private bool TripsUnavailable => Services.RoutingPreparing || Trips.Unavailable || Best.Result is { ByRoad: false, Pick: not null };

    /// <summary>The Best near you the map shows while its pane is open; none while the one in is for another fuel.</summary>
    private BestNearby? MapBest => BestOpen && Best.ResultQuery?.Fuel == _fuel ? Best.Result : null;

    /// <summary>The trip plan the map shows in trip mode; none while the one in is for another fuel.</summary>
    private TripPlan? MapTrip => TripMode && Trips.PlanQuery?.Fuel == _fuel ? Trips.Plan : null;

    /// <summary>
    /// The station ringed on the map: the one whose details are open, else the one Best near you or the trip shows on top
    /// when it isn't the pick (the pick has its flag).
    /// </summary>
    private long? MapSelected => Station ?? (MapTrip is not null ? Trips.SelectedId : MapBest is not null ? Best.SelectedId : null);

    /// <summary>The pick the phone chip shows: once the user is located, while no pane is open.</summary>
    private RankedStation? ChipPick =>
        Station is null && !ListOpen && Best.Origin is { IsChosen: false } && Best.ResultQuery?.Fuel == _fuel ? Best.Result?.Pick : null;

    private string ComparisonLabel => Comparison.Count > 0 ? L["ComparisonCount", Comparison.Count] : L["Comparison"];

    /// <summary>The one message worth showing right now, most important first.</summary>
    private string? StatusMessage
    {
        get
        {
            if (_notice is not null)
            {
                return _notice;
            }

            if (_locating)
            {
                return L["Locating"];
            }

            if (_loadError != ApiError.None)
            {
                return _loadError == ApiError.RateLimited ? L["RateLimited", (int)Math.Ceiling(_retryDelay.TotalSeconds)] : L["LoadFailed"];
            }

            // A trip is fitted whole, zoomed out: its stations come with it.
            if (!TripMode && _viewport is { } viewport && !StationViewport.ShouldFetch(viewport))
            {
                return L["ZoomIn"];
            }

            if (_visibleCount == 0 && (_loading || _loaded))
            {
                return _loading ? L["LoadingStations"] : L["NoStations"];
            }

            return null;
        }
    }

    protected override void OnInitialized()
    {
        Favorites.Changed += OnFavoritesChanged;
        Overrides.Changed += OnHoursCorrected;
        _ = Overrides.LoadAsync();
        Comparison.Changed += OnComparisonChanged;
        Updates.Changed += OnUpdateChanged;
        _appHost = ServiceProvider.GetService<IAppHost>();
        if (_appHost is not null)
        {
            _appHost.Changed += OnAppHostChanged;
        }

        Updates.ReloadDue += OnReloadDue;
        Best.Changed += OnBestChanged;
        Cars.Changed += OnCarsChanged;
        Trips.Changed += OnTripChanged;
        Places.Changed += OnPlacesChanged;
        Services.Changed += OnServicesChanged;
        Services.RoutingReady += OnRoutingReady;
        _servicesWatch = Services.Watch();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Station is null)
        {
            _stationPushed = false;
            _pendingStation = null;
        }

        if (!ListOpen)
        {
            _listPushed = false;
        }

        if (View != CarsView)
        {
            _carsPushed = false;
            _carsOverTrip = false;
        }

        if (View is not (TripView or CarsView))
        {
            _tripPushed = false;
        }

        if (View != PlacesView)
        {
            _placesPushed = false;
            _placesPurpose = PlacePurpose.Destination;
        }

        if (!BestOpen)
        {
            // Best near you's choice lasts while its pane is open, under details, My cars or the address search too: closed,
            // or a trip opened, it's the pick again.
            _fitted = null;
            Best.Select(null);
        }

        if (!TripMode)
        {
            _fittedPlan = null;
        }

        // A link to ?view=trip opened cold, or a trip ended in another way: Best near you takes its place.
        if (View == TripView && _tripLoaded && !Trips.IsOpen)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = BestView, ["station"] = null }),
                replace: true);
            return;
        }

        // A pane changing size makes the map's last move again, for what it was made for only: what a link opened cold shows
        // too, before the map is there.
        if ((View, Station) != _autoMoveFor)
        {
            _autoMoveFor = (View, Station);
            if (_map is not null)
            {
                await _map.ForgetAutoMoveAsync();
            }
        }

        if (_map is not null)
        {
            await SyncSelectedAsync();
            await SyncPinAsync();
            await RenderMarkersAsync();
            await RenderTripAsync();
            await FitToBestAsync();
            await FitToTripAsync();
        }

        if (_placed)
        {
            await StartLinkedTripAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Now rather than when the About dialog opens: the version shown is then the one this tab runs.
        _ = Notes.LoadReleaseAsync();
        _map = new MapInterop(JS);

        // A reload for a new release reopens as the page was (ReloadAsync): its view, fuel (another tab may have changed the
        // saved one since) and history.
        var saved = await _map.TakeSavedViewAsync();
        _fuel = Fuels.Normalize(saved?.Fuel ?? await Preferences.GetAsync(Fuels.PreferenceKey));
        _stations.SetFuel(_fuel);
        await Best.SetFuelAsync(_fuel);
        await Cars.SetFuelAsync(_fuel);
        await Favorites.LoadAsync();
        await Comparison.LoadAsync();
        await Places.LoadAsync();

        // The trip the tab had open, as it was planned: a tab Android discarded while Google Maps navigated comes back to it.
        // Planned again (once the map is up) only if its plan doesn't answer this fuel and car.
        await Trips.LoadAsync();
        _tripLoaded = true;
        if (View == TripView && !Trips.IsOpen)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = BestView, ["station"] = null }),
                replace: true);
        }

        var openedOnStation = Station is not null;
        _centerOnStation = openedOnStation && saved is null;
        if (saved is not null)
        {
            _stationPushed = saved.StationPushed && Station is not null;
            _listPushed = saved.ListPushed && ListOpen;
            _carsPushed = saved.CarsPushed && View == CarsView;
            _carsOverTrip = saved.CarsOverTrip && View == CarsView;
            _tripPushed = saved.TripPushed && (View == TripView || _carsOverTrip);
            _placesPushed = saved.PlacesPushed && View == PlacesView;
            _keepView = BestOpen || View == TripView || _carsOverTrip;
        }

        var (center, zoom) = saved is null ? (Overview, OverviewZoom) : (new GeoPoint(saved.Lat, saved.Lon), saved.Zoom);
        await _map.CreateAsync(
            _mapElement,
            new MapOptions(
                Options.MapStyleUrl, Options.MapDarkStyleUrl, center.Latitude, center.Longitude, zoom,
                CultureInfo.CurrentUICulture.TwoLetterISOLanguageName),
            this);
        _mapReady = true;
        Updates.Start();
        await SyncSelectedAsync();
        await RenderTripAsync();
        await FitToTripAsync();
        var planning = Trips.SetFuelAsync(_fuel);
        if (_pendingStation is not null)
        {
            await ShowStationAsync(_pendingStation);
        }

        StateHasChanged();

        if (saved is null)
        {
            // Opened on a station, or on the trip (a tab restored while Google Maps navigated): that's what the map shows,
            // and the location only adds the user's dot.
            await LocateAsync(moveMap: !openedOnStation && View != TripView, fallBackToMontreal: true);
        }
        else if (saved is { UserLat: { } userLat, UserLon: { } userLon })
        {
            // The dot where it was, without asking for the location again: no spinner, notice or permission prompt, which
            // a page reloaded out of sight would otherwise show when it's back.
            _userLocation = new GeoPoint(userLat, userLon);
            await _map.ShowUserLocationAsync(_userLocation.Value);
            await Best.SetOriginAsync(new BestOrigin(_userLocation.Value));
            Best.Select(saved.BestSelectedId);
            StateHasChanged();
        }

        _placed = true;
        await planning;
        await StartLinkedTripAsync();
    }

    /// <summary>Starts the trip <see cref="To"/> asks for, once the page is placed, as if the place was picked in Your places.</summary>
    /// <remarks>
    /// The trip takes the link's place in the history, as a link opened cold, rather than going on top of it: closing the
    /// trip goes back, and back to the link would start it again. Until the URL without the link is in (in the Android app
    /// the page's URL changes only once the WebView has navigated), <see cref="_linkedTo"/> keeps it from starting twice.
    /// </remarks>
    private async Task StartLinkedTripAsync()
    {
        if (To is not { Length: > 0 } to)
        {
            _linkedTo = null;
            return;
        }

        var link = $"{From}>{to}>{Pick}";
        if (_linkedTo == link)
        {
            return;
        }

        _linkedTo = link;
        // Read now: the trip's navigation takes them out of the URL, and the parameters with them.
        var (fromName, pick) = (From, Pick);
        var from = fromName is { Length: > 0 } ? PlaceNamed(fromName) : null;
        if (PlaceNamed(to) is { } place && (fromName is not { Length: > 0 } || from is not null))
        {
            await StartTripAsync(TripDestination.To(place), from, fromLink: true);
            if (pick is { } id)
            {
                await Trips.SelectAsync(id);
            }
        }

        if (!Trips.IsOpen)
        {
            // A place since forgotten, or nowhere to start from: only the link goes.
            Navigation.NavigateTo(
                Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["to"] = null, ["from"] = null, ["pick"] = null }),
                replace: true);
        }
    }

    /// <summary>A saved place as links name it: <c>home</c>, <c>work</c>, or its id.</summary>
    private SavedPlace? PlaceNamed(string name) => name switch
    {
        "home" => Places.Home,
        "work" => Places.Work,
        _ => Places.Places.FirstOrDefault(p => p.Id == name),
    };

    /// <summary>
    /// Shows where the user is and, with <paramref name="moveMap"/>, flies there. When the location isn't available,
    /// <paramref name="fallBackToMontreal"/> (page load) shows Montréal instead of leaving the province overview. Best near you
    /// ranks from the new location.
    /// </summary>
    private async Task LocateAsync(bool moveMap, bool fallBackToMontreal)
    {
        _locating = true;
        StateHasChanged();
        var location = await DeviceLocation.GetCurrentAsync();
        _locating = false;
        _locationProblem = location.Status == LocationStatus.Ok ? null : location.Status;

        if (location.Status == LocationStatus.Ok)
        {
            _userLocation = location.Point;
            await _map!.ShowUserLocationAsync(location.Point);
            if (moveMap)
            {
                await _map.FlyToAsync(location.Point, Math.Max(UserZoom, _viewport?.Zoom ?? 0));
            }

            await Best.SetOriginAsync(new BestOrigin(location.Point, AccuracyMeters: location.AccuracyMeters));
        }
        else
        {
            string problem = location.Status == LocationStatus.Denied ? L["LocationDenied"] : L["LocationUnavailable"];
            if (moveMap && fallBackToMontreal)
            {
                ShowNotice($"{problem} {L["ShowingMontreal"]}");
                await _map!.FlyToAsync(Montreal, FallbackZoom);
            }
            else
            {
                ShowNotice(problem);
            }
        }

        StateHasChanged();
    }

    /// <summary>The map's fuel; Best near you ranks for it, and the car being driven takes it.</summary>
    private async Task SetFuelAsync(string fuel)
    {
