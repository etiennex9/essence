        _fuel = fuel;
        await Preferences.SetAsync(Fuels.PreferenceKey, fuel);
        await Best.SetFuelAsync(fuel);
        await Cars.SetFuelAsync(fuel);
        var planning = Trips.SetFuelAsync(fuel);
        await RenderMarkersAsync();
