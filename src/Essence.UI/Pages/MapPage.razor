@page "/"
@implements IMapListener
@implements IAsyncDisposable
@inject EssenceApiClient Api
@inject FavoriteStations Favorites
@inject ComparedStations Comparison
@inject BestNearYou Best
@inject CarProfiles Cars
@inject IDeviceLocation DeviceLocation
@inject IPreferenceStore Preferences
@inject ReleaseNotes Notes
@inject UpdateCheck Updates
@inject EssenceUIOptions Options
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Strings> L

<PageTitle>Essence</PageTitle>

<div class="page">
    <div class="map" @ref="_mapElement" role="region" aria-label="@L["MapLabel"]"></div>

    <div class="toolbar">
        <FuelSelector Value="@_fuel" ValueChanged="SetFuelAsync" />
        <div class="tools">
            <button type="button" class="tool @(View == FavoritesView ? "is-active" : null)" @onclick="() => ToggleListAsync(FavoritesView)"
                    aria-pressed="@(View == FavoritesView ? "true" : "false")" aria-label="@L["Favorites"]" title="@L["Favorites"]">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linejoin="round"><path d="@Icons.Star" /></svg>
            </button>
            <button type="button" class="tool @(View == CompareView ? "is-active" : null)" @onclick="() => ToggleListAsync(CompareView)"
                    aria-pressed="@(View == CompareView ? "true" : "false")" aria-label="@ComparisonLabel" title="@ComparisonLabel">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Compare" /></svg>
                @if (Comparison.Count > 0)
                {
                    <span class="badge" aria-hidden="true">@Comparison.Count</span>
                }
            </button>
            <button type="button" class="tool @(BestOpen ? "is-active" : null)" @onclick="ToggleBestAsync"
                    aria-pressed="@(BestOpen ? "true" : "false")" aria-label="@L["BestNearYou"]" title="@L["BestNearYou"]">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"><path d="@Icons.Pump" /></svg>
            </button>
        </div>
    </div>

    <div class="status-slot">
        <UpdatePrompt Visible="@Updates.Available" OnReload="() => ReloadAsync(automatic: false)" />
        <StatusChip Message="@StatusMessage" Busy="@(_locating || _loading)" />
        @* Phones only (see the CSS), and outside the status's live region, so it isn't announced at each refresh. *@
        @if (ChipPick is { } pick)
        {
            var brand = BrandCatalog.For(pick.Brand);
            <button type="button" class="best-chip" @onclick="() => ShowListAsync(BestView)">
                <span class="logo @(brand.Monogram.Length > 1 ? "is-wide" : null)" style="--logo-bg: @brand.Background; --logo-fg: @brand.Foreground">
                    @if (brand.LogoUrl is { } logoUrl)
                    {
                        <img src="@logoUrl" alt="" />
                    }
                    else
                    {
                        @brand.Monogram
                    }
                </span>
                <span class="text">
                    <span class="kicker">
                        @L["BestChipKicker"]
                        <span class="distance">@($"· {L["DistanceApprox", Formatting.Km(pick.DistanceKm, CultureInfo.CurrentCulture)]}")</span>
                    </span>
                    <span class="name">@($"{brand.Name ?? L["Independent"]} {Formatting.Price(pick.PriceCents, CultureInfo.CurrentCulture)}")</span>
                </span>
                @if (pick.Id != Best.Result?.ReferenceId)
                {
                    <span class="saves">
                        @L["BestChipSaves", Formatting.Money(pick.SavesDollars, CultureInfo.CurrentCulture)]
                        <span>@L["BestChipVsClosest"]</span>
                    </span>
                }
                else
                {
                    <span class="saves is-neutral">@L["Closest"]</span>
                }
            </button>
        }
    </div>

    @* Alone in the bottom-left corner (the map's own controls are bottom-right), under a bottom sheet while one is open. *@
    <button type="button" class="tool about" @onclick="() => _about!.ShowAsync()" aria-label="@L["About"]" title="@L["About"]">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 16.5v-5M12 7.75v.01" /></svg>
    </button>

    @* The details open over a list (?view=…&station=…): closing them goes back to it. *@
    @if (Station is { } stationId)
    {
        <StationDetails StationId="stationId" Fuel="@_fuel" UserLocation="_userLocation" DataAsOf="_dataAsOf" OnClose="CloseDetailsAsync"
                        OnLoaded="OnStationLoadedAsync" />
    }
    else if (View == FavoritesView)
    {
        <FavoritesPanel Fuel="@_fuel" UserLocation="_userLocation" OnClose="CloseListAsync" OnOpenStation="OpenListedStation"
                        OnCompareAll="() => ShowListAsync(CompareView)" />
    }
    else if (View == CompareView)
    {
        <ComparisonPanel Fuel="@_fuel" UserLocation="_userLocation" OnClose="CloseListAsync" OnOpenStation="OpenListedStation" />
    }
    else if (View == BestView)
    {
        <BestPanel Locating="_locating" LocationProblem="_locationProblem" OnClose="CloseListAsync" OnOpenStation="OpenListedStation"
                   OnOpenCars="ShowCars" OnLocate="() => LocateAsync(moveMap: false, fallBackToMontreal: false)"
                   OnUseMapCenter="UseMapCenterAsync" />
    }
    else if (View == CarsView)
    {
        <MyCarsPanel OnClose="CloseCarsAsync" />
    }

    <AboutDialog @ref="_about" />
</div>

@code {
    private const string FuelPreferenceKey = "essence.fuel";
    private const string FavoritesView = "favorites";
    private const string CompareView = "compare";
    private const string BestView = "best";

    /// <summary>My cars, pushed over Best near you.</summary>
    private const string CarsView = "cars";

    private const double CompactBelowZoom = 12;
    private const double OverviewZoom = 5.5;
    private const double UserZoom = 13;
    private const double FallbackZoom = 11;
    private const double StationZoom = 14;
    private static readonly GeoPoint Overview = new(46.6, -72.3);
    private static readonly GeoPoint Montreal = new(45.5017, -73.5673);
    private static readonly TimeSpan NoticeDuration = TimeSpan.FromSeconds(6);
    private static readonly TimeSpan FailedRetryDelay = TimeSpan.FromSeconds(15);

    /// <summary>Prices change at most every 5 minutes; an identical request within this window is skipped.</summary>
    private static readonly TimeSpan FetchFreshness = TimeSpan.FromSeconds(30);

    private readonly StationViewport _stations = new();
    private MapInterop? _map;
    private AboutDialog? _about;
    private ElementReference _mapElement;
    private string _fuel = Fuels.Default;
    private Viewport? _viewport;
    private GeoPoint? _userLocation;
    private bool _mapReady;

    /// <summary>The map is where the page means it to be at startup: on the user, a station, or a reloaded view.</summary>
    private bool _placed;
    private bool _locating;

    /// <summary>Why the location couldn't be had, the last time it was asked for.</summary>
    private LocationStatus? _locationProblem;

    private bool _loading;
    private bool _loaded;
    private int _visibleCount;
    private ApiError _loadError;
    private TimeSpan _retryDelay;
    private string? _notice;
    private (string Key, DateTimeOffset At)? _lastFetch;
    private CancellationTokenSource? _loadCts;
    private CancellationTokenSource? _retryCts;
    private CancellationTokenSource? _noticeCts;

    /// <summary>When the prices shown were imported, as the API says; the next refresh is timed from it.</summary>
    private DateTimeOffset? _dataAsOf;

    /// <summary>Refreshes in a row that found nothing newer, or failed.</summary>
    private int _lateRefreshes;

    private DateTimeOffset? _refreshDueAt;
    private CancellationTokenSource? _refreshCts;

    /// <summary>The page is out of sight: the refresh waits until it's back.</summary>
    private bool _hidden;

    /// <summary>Set when this page pushed the <c>?station=</c> history entry, so closing goes back instead of forward.</summary>
    private bool _stationPushed;

    /// <summary>The same for <c>?view=</c>, the list open.</summary>
    private bool _listPushed;

    /// <summary>The same for <c>?view=cars</c>, pushed over <c>?view=best</c>.</summary>
    private bool _carsPushed;

    /// <summary>A cold load with <c>?station=</c> centers on that station once it's loaded, instead of on the user.</summary>
    private bool _centerOnStation;
    private StationDetail? _pendingStation;

    /// <summary>What the map was last fitted to for Best near you: where from, the pick and the closest.</summary>
    private (GeoPoint Origin, long Pick, long? Closest)? _fitted;

    /// <summary>A reload reopened Best near you on the view it had: the answer it gets again doesn't move the map.</summary>
    private bool _keepView;

    /// <summary>The emphasis last given to the markers (<see cref="MapInterop.SetEmphasisAsync"/>), sent again only when it changes.</summary>
    private string? _emphasis;

    [SupplyParameterFromQuery(Name = "station")]
    public long? Station { get; set; }

    /// <summary>The list open: <c>favorites</c>, <c>compare</c>, <c>best</c> or <c>cars</c>.</summary>
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private bool ListOpen => View is FavoritesView or CompareView or BestView or CarsView;

    /// <summary>Best near you is open, maybe under My cars or a station's details.</summary>
    private bool BestOpen => View is BestView or CarsView;

    /// <summary>The Best near you the map shows while its pane is open; none while the one in is for another fuel.</summary>
    private BestNearby? MapBest => BestOpen && Best.ResultQuery?.Fuel == _fuel ? Best.Result : null;

    /// <summary>The pick the phone chip shows: once the user is located, while no pane is open.</summary>
    private RankedStation? ChipPick =>
        Station is null && !ListOpen && Best.Origin is { IsMapCenter: false } && Best.ResultQuery?.Fuel == _fuel ? Best.Result?.Pick : null;

    private string ComparisonLabel => Comparison.Count > 0 ? L["ComparisonCount", Comparison.Count] : L["Comparison"];

    /// <summary>The one message worth showing right now, most important first.</summary>
    private string? StatusMessage
    {
        get
        {
            if (_notice is not null)
            {
                return _notice;
            }

            if (_locating)
            {
                return L["Locating"];
            }

            if (_loadError != ApiError.None)
            {
                return _loadError == ApiError.RateLimited ? L["RateLimited", (int)Math.Ceiling(_retryDelay.TotalSeconds)] : L["LoadFailed"];
            }

            if (_viewport is { } viewport && !StationViewport.ShouldFetch(viewport))
            {
                return L["ZoomIn"];
            }

            if (_visibleCount == 0 && (_loading || _loaded))
            {
                return _loading ? L["LoadingStations"] : L["NoStations"];
            }

            return null;
        }
    }

    protected override void OnInitialized()
    {
        Favorites.Changed += OnFavoritesChanged;
        Comparison.Changed += OnComparisonChanged;
        Updates.Changed += OnUpdateChanged;
        Updates.ReloadDue += OnReloadDue;
        Best.Changed += OnBestChanged;
        Cars.Changed += OnCarsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Station is null)
        {
            _stationPushed = false;
            _pendingStation = null;
        }

        if (!ListOpen)
        {
            _listPushed = false;
        }

        if (View != CarsView)
        {
            _carsPushed = false;
        }

        if (!BestOpen)
        {
            _fitted = null;
        }

        if (_map is not null)
        {
            await _map.SetSelectedAsync(Station);
            await RenderMarkersAsync();
            await FitToBestAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Now rather than when the About dialog opens: the version shown is then the one this tab runs.
        _ = Notes.LoadReleaseAsync();
        _map = new MapInterop(JS);

        // A reload for a new release reopens as the page was (ReloadAsync): its view, fuel (another tab may have changed the
        // saved one since) and history.
        var saved = await _map.TakeSavedViewAsync();
        _fuel = Fuels.Normalize(saved?.Fuel ?? await Preferences.GetAsync(FuelPreferenceKey));
        _stations.SetFuel(_fuel);
        await Best.SetFuelAsync(_fuel);
        await Cars.SetFuelAsync(_fuel);
        await Favorites.LoadAsync();
        await Comparison.LoadAsync();
        var openedOnStation = Station is not null;
        _centerOnStation = openedOnStation && saved is null;
        if (saved is not null)
        {
            _stationPushed = saved.StationPushed && Station is not null;
            _listPushed = saved.ListPushed && ListOpen;
            _carsPushed = saved.CarsPushed && View == CarsView;
            _keepView = BestOpen;
        }

        var (center, zoom) = saved is null ? (Overview, OverviewZoom) : (new GeoPoint(saved.Lat, saved.Lon), saved.Zoom);
        await _map.CreateAsync(
            _mapElement,
            new MapOptions(
                Options.MapStyleUrl, Options.MapDarkStyleUrl, center.Latitude, center.Longitude, zoom, CompactBelowZoom,
                CultureInfo.CurrentUICulture.TwoLetterISOLanguageName),
            this);
        _mapReady = true;
        Updates.Start();
        await _map.SetSelectedAsync(Station);
        if (_pendingStation is not null)
        {
            await ShowStationAsync(_pendingStation);
        }

        StateHasChanged();

        if (saved is null)
        {
            // Opened on a station: that's where the map goes, and the location only adds the user's dot.
            await LocateAsync(moveMap: !openedOnStation, fallBackToMontreal: true);
        }
        else if (saved is { UserLat: { } userLat, UserLon: { } userLon })
        {
            // The dot where it was, without asking for the location again: no spinner, notice or permission prompt, which
            // a page reloaded out of sight would otherwise show when it's back.
            _userLocation = new GeoPoint(userLat, userLon);
            await _map.ShowUserLocationAsync(_userLocation.Value);
            await Best.SetOriginAsync(new BestOrigin(_userLocation.Value));
            StateHasChanged();
        }

        _placed = true;
    }

    /// <summary>
    /// Shows where the user is and, with <paramref name="moveMap"/>, flies there. When the location isn't available,
    /// <paramref name="fallBackToMontreal"/> (page load) shows Montréal instead of leaving the province overview. Best near you
    /// ranks from the new location.
    /// </summary>
    private async Task LocateAsync(bool moveMap, bool fallBackToMontreal)
    {
        _locating = true;
        StateHasChanged();
        var location = await DeviceLocation.GetCurrentAsync();
        _locating = false;
        _locationProblem = location.Status == LocationStatus.Ok ? null : location.Status;

        if (location.Status == LocationStatus.Ok)
        {
            _userLocation = location.Point;
            await _map!.ShowUserLocationAsync(location.Point);
            if (moveMap)
            {
                await _map.FlyToAsync(location.Point, Math.Max(UserZoom, _viewport?.Zoom ?? 0));
            }

            await Best.SetOriginAsync(new BestOrigin(location.Point, AccuracyMeters: location.AccuracyMeters));
        }
        else
        {
            string problem = location.Status == LocationStatus.Denied ? L["LocationDenied"] : L["LocationUnavailable"];
            if (moveMap && fallBackToMontreal)
            {
                ShowNotice($"{problem} {L["ShowingMontreal"]}");
                await _map!.FlyToAsync(Montreal, FallbackZoom);
            }
            else
            {
                ShowNotice(problem);
            }
        }

        StateHasChanged();
    }

    /// <summary>The map's fuel; Best near you ranks for it, and the car being driven takes it.</summary>
    private async Task SetFuelAsync(string fuel)
    {
        if (!_stations.SetFuel(fuel))
        {
            return;
        }

        _fuel = fuel;
        await Preferences.SetAsync(FuelPreferenceKey, fuel);
        await Best.SetFuelAsync(fuel);
        await Cars.SetFuelAsync(fuel);
        await RenderMarkersAsync();
        if (_viewport is { } viewport)
        {
            await LoadAsync(viewport);
        }
    }

    public async Task OnViewportChangedAsync(Viewport viewport)
    {
        _viewport = viewport;
        await RenderMarkersAsync();
        await LoadAsync(viewport);
    }

    /// <summary>
    /// Fetches the stations around the viewport. A newer call cancels an older one still in flight, and the same request
    /// isn't repeated while it's in flight or fresh (map events often report the same view twice). Each success plans a
    /// <paramref name="background"/> refresh of the same view for when the next prices should be in; that one fetches
    /// even if fresh, shows no progress, and fails silently.
    /// </summary>
    private async Task LoadAsync(Viewport viewport, bool background = false)
    {
        if (!StationViewport.ShouldFetch(viewport))
        {
            _retryCts?.Cancel();
            _loadCts?.Cancel();
            CancelRefresh();
            _lastFetch = null;
            _loading = false;
            _loadError = ApiError.None;
            StateHasChanged();
            return;
        }

        var fuel = _fuel;
        var radiusKm = StationViewport.FetchRadiusKm(viewport);
        var key = string.Create(CultureInfo.InvariantCulture, $"{fuel}|{viewport.CenterLat:0.0000}|{viewport.CenterLon:0.0000}|{radiusKm}");
        if (!background && _lastFetch is { } last && last.Key == key && DateTimeOffset.UtcNow - last.At < FetchFreshness)
        {
            return;
        }

        // Planned again once this one is in.
        _retryCts?.Cancel();
        _loadCts?.Cancel();
        CancelRefresh();
        var cts = _loadCts = new CancellationTokenSource();
        _lastFetch = (key, DateTimeOffset.UtcNow);
        if (!background)
        {
            _loading = true;
            StateHasChanged();
        }

        ApiResult<List<NearbyStation>> result;
        try
        {
            result = await Api.GetNearbyAsync(viewport.CenterLat, viewport.CenterLon, radiusKm, fuel, StationViewport.FetchLimit, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || fuel != _fuel)
        {
            return;
        }

        if (background && result.Value is null)
        {
            // The prices shown stay; the next refresh tries again.
            _lastFetch = null;
            _lateRefreshes++;
            ScheduleRefresh(result.Error == ApiError.RateLimited ? result.RetryAfter : null);
            return;
        }

        _loading = false;
        _loadError = result.Error;
        if (result.Value is { } stations)
        {
            _loaded = true;
            _lateRefreshes = background && result.DataAsOf == _dataAsOf ? _lateRefreshes + 1 : 0;
            _dataAsOf = result.DataAsOf;
            _stations.Merge(stations, viewport.Center);
            await RenderMarkersAsync();
            ScheduleRefresh();
        }
        else
        {
            _lastFetch = null;
            _retryDelay = result.Error == ApiError.RateLimited ? result.RetryAfter ?? FailedRetryDelay : FailedRetryDelay;
            _ = RetryLaterAsync(_retryDelay, (_retryCts = new CancellationTokenSource()).Token);
        }

        StateHasChanged();
    }

    private async Task RetryLaterAsync(TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (_viewport is { } viewport)
        {
            await InvokeAsync(() => LoadAsync(viewport));
        }
    }

    /// <summary>Plans the next background refresh: by default timed to the next import, later while it's late.</summary>
    private void ScheduleRefresh(TimeSpan? delay = null)
    {
        var now = DateTimeOffset.UtcNow;
        _refreshDueAt = now + (delay ?? RefreshSchedule.Next(_dataAsOf, now, _lateRefreshes));
        StartRefreshTimer();
    }

    /// <summary>Waits for the planned refresh, unless the page is hidden. One that's overdue runs at once.</summary>
    private void StartRefreshTimer()
    {
        _refreshCts?.Cancel();
        if (_hidden || _refreshDueAt is not { } dueAt)
        {
            return;
        }

        var cts = _refreshCts = new CancellationTokenSource();
        _ = RefreshLaterAsync(dueAt - DateTimeOffset.UtcNow, cts.Token);
    }

    private async Task RefreshLaterAsync(TimeSpan delay, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(delay > TimeSpan.Zero ? delay : TimeSpan.Zero, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() => !cancellationToken.IsCancellationRequested && _viewport is { } viewport
            ? LoadAsync(viewport, background: true)
            : Task.CompletedTask);
    }

    private void CancelRefresh()
    {
        _refreshCts?.Cancel();
        _refreshDueAt = null;
    }

    public Task OnVisibilityChangedAsync(bool visible)
    {
        Updates.SetVisible(visible);
        Best.SetVisible(visible);
        _hidden = !visible;
        if (_hidden)
        {
            _refreshCts?.Cancel();
        }
        else
        {
            StartRefreshTimer();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Reloads the page for a new release: asked for by the user, or <paramref name="automatic"/> while the page is away or
    /// just back (<see cref="UpdateCheck"/>). Once the map is placed, the page reopens as it is; before that, it starts over.
    /// An automatic reload that can't save the view doesn't happen: the offer to reload stays.
    /// </summary>
    private async Task ReloadAsync(bool automatic)
    {
        if (_mapReady)
        {
            await _map!.ReloadAsync(new ReloadState(_fuel, _stationPushed, _listPushed, _carsPushed), saveView: _placed, automatic);
        }
    }

    private async Task RenderMarkersAsync()
    {
        if (!_mapReady || _viewport is null)
        {
            return;
        }

        var visible = _stations.Visible(_viewport);
        _visibleCount = visible.Count;
        var best = MapBest;
        var markers = visible.Select(v => ToMarker(v, best)).ToList();
        if (best is not null)
        {
            // A ranked station 9 km away is usually not among the stations fetched around the view, which setMarkers would drop.
            var shown = markers.Select(m => m.Id).ToHashSet();
            var prices = visible.Where(v => v.HasPrice).Select(v => v.Price!.PriceCents!.Value).Order().ToList();
            markers.AddRange(best.Stations.Where(s => !shown.Contains(s.Id)).Select(s => ToMarker(s, best, prices)));
        }

        await SetEmphasisAsync(best);
        await _map!.SetMarkersAsync(markers);
    }

    /// <summary>Best near you's pick and closest stand out on the map, and the stations it didn't list fade.</summary>
    private async Task SetEmphasisAsync(BestNearby? best)
    {
        var listed = best?.Stations.Select(s => s.Id).ToList();
        var key = best is null ? null : $"{best.Pick?.Id}|{best.ClosestId}|{string.Join(',', listed!)}";
        if (key == _emphasis)
        {
            return;
        }

        _emphasis = key;
        await _map!.SetEmphasisAsync(best?.Pick?.Id, best?.ClosestId, listed, L["BestValue"], L["Closest"]);
    }

    private MarkerModel ToMarker(VisibleStation visible, BestNearby? best)
    {
        var station = visible.Station;
        var brand = BrandCatalog.For(station.Brand);
        var name = $"{brand.Name ?? L["Independent"]}, {station.Address}";
        var price = Formatting.Price(visible.HasPrice ? visible.Price!.PriceCents : null, CultureInfo.CurrentCulture);
        string label = visible.HasPrice ? L["MarkerPrice", name, price] : L["MarkerUnavailable", name, _fuel];
        var favorite = Favorites.IsFavorite(station.Id);
        return new MarkerModel(
            station.Id, station.Latitude, station.Longitude, Label(label, station.Id, favorite, best), price, !visible.HasPrice,
            ToneName(visible.Tone), visible.ZIndex, favorite, brand.Monogram, brand.Background, brand.Foreground, brand.LogoUrl);
    }

    /// <summary>A station Best near you ranked, drawn even though it's not among the stations fetched around the view.</summary>
    private MarkerModel ToMarker(RankedStation station, BestNearby best, IReadOnlyList<decimal> visiblePrices)
    {
        var brand = BrandCatalog.For(station.Brand);
        var price = Formatting.Price(station.PriceCents, CultureInfo.CurrentCulture);
        string label = L["MarkerPrice", $"{brand.Name ?? L["Independent"]}, {station.Address}", price];
        var favorite = Favorites.IsFavorite(station.Id);
        var tone = StationViewport.ToneOf(station.PriceCents, visiblePrices);
        return new MarkerModel(
            station.Id, station.Latitude, station.Longitude, Label(label, station.Id, favorite, best), price, false, ToneName(tone),
            visiblePrices.Count + 1, favorite, brand.Monogram, brand.Background, brand.Foreground, brand.LogoUrl);
    }

    /// <summary>A marker's label, with what makes its station stand out: a favorite, or Best near you's pick or closest.</summary>
    private string Label(string label, long id, bool favorite, BestNearby? best)
    {
        if (favorite)
        {
            label = L["MarkerFavorite", label];
        }

        if (best?.Pick?.Id == id)
        {
            label = L["MarkerBest", label];
        }

        if (best?.ClosestId == id)
        {
            label = L["MarkerClosest", label];
        }

        return label;
    }

    private static string ToneName(PriceTone tone) => tone switch
    {
        PriceTone.Low => "low",
        PriceTone.Mid => "mid",
        PriceTone.High => "high",
        _ => "",
    };

    /// <summary>
    /// With Best near you open, fits the map to where the user is, the pick and the closest, beside the pane: when it opens
    /// and when they change, not when the same answer is refreshed.
    /// </summary>
    private async Task FitToBestAsync()
    {
        if (!_mapReady || View != BestView || Station is not null || MapBest is not { Pick: { } pick } best
            || Best.Origin is not { } origin)
        {
            return;
        }

        var fitted = (origin.Point, pick.Id, best.ClosestId);
        if (_fitted == fitted)
        {
            return;
        }

        _fitted = fitted;
        if (_keepView)
        {
            _keepView = false;
            return;
        }

        List<GeoPoint> points = [origin.Point, new(pick.Latitude, pick.Longitude)];
        points.AddRange(best.Stations.Where(s => s.Id == best.ClosestId).Select(s => new GeoPoint(s.Latitude, s.Longitude)));
        await _map!.FitBoundsAsync(
            points.Min(p => p.Longitude), points.Min(p => p.Latitude), points.Max(p => p.Longitude), points.Max(p => p.Latitude),
            besidePane: true);
    }

    public Task OnMarkerClickedAsync(long id)
    {
        if (Station != id)
        {
            // Switching stations replaces the entry, so Back still closes the pane instead of walking through stations.
            var replace = Station is not null;
            _stationPushed |= !replace;
            _centerOnStation = false;
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", id), replace: replace);
        }

        return Task.CompletedTask;
    }

    /// <summary>A station picked in a list: its details open over it, and the map flies to it.</summary>
    private void OpenListedStation(long id)
    {
        _stationPushed = true;
        _centerOnStation = true;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", id));
    }

    /// <summary>Closes the top-most pane: the details, else My cars, else the list.</summary>
    public Task OnDismissAsync() => Station is not null ? CloseDetailsAsync() : View == CarsView ? CloseCarsAsync() : CloseListAsync();

    private Task ToggleListAsync(string view) => View == view && Station is null ? CloseListAsync() : ShowListAsync(view);

    private async Task ShowListAsync(string view)
    {
        if (View == view)
        {
            // The list is under the details.
            await CloseDetailsAsync();
            return;
        }

        // The list takes the place of the details or of the other list, so Back still leads where it did. It counts as
        // pushed unless the entry it replaces wasn't (a link opened cold).
        var replace = Station is not null || ListOpen;
        _listPushed = !replace || _stationPushed || _listPushed;
        _stationPushed = false;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = view, ["station"] = null }),
            replace: replace);
    }

    private async Task CloseListAsync()
    {
        if (!ListOpen)
        {
            return;
        }

        if (_listPushed)
        {
            _listPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", (string?)null), replace: true);
        }
    }

    /// <summary>
    /// The pump: opens Best near you, or closes it. Opening asks for the location again, so the answer is for where the
    /// user is now; the pane shows while it's found.
    /// </summary>
    private async Task ToggleBestAsync()
    {
        if (View == BestView && Station is null)
        {
            await CloseListAsync();
            return;
        }

        if (View == CarsView && Station is null)
        {
            await CloseCarsAsync();
        }
        else
        {
            await ShowListAsync(BestView);
        }

        await LocateAsync(moveMap: false, fallBackToMontreal: false);
    }

    /// <summary>Best near you ranks from the map's centre: the location is off, or approximate.</summary>
    private async Task UseMapCenterAsync()
    {
        if (_viewport is { } viewport)
        {
            await Best.SetOriginAsync(new BestOrigin(viewport.Center, IsMapCenter: true));
        }
    }

    /// <summary>My cars opens over Best near you as a history entry of its own, so Back returns to the pane.</summary>
    private void ShowCars()
    {
        _carsPushed = true;
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = CarsView, ["station"] = null }));
    }

    private async Task CloseCarsAsync()
    {
        if (View != CarsView)
        {
            return;
        }

        if (_carsPushed)
        {
            _carsPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            // Opened cold: Best near you takes its place.
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("view", BestView), replace: true);
        }
    }

    private async Task CloseDetailsAsync()
    {
        if (Station is null)
        {
            return;
        }

        if (_stationPushed)
        {
            _stationPushed = false;
            await JS.InvokeVoidAsync("history.back");
        }
        else
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("station", (long?)null), replace: true);
        }
    }

    private async Task OnStationLoadedAsync(StationDetail station)
    {
        if (_mapReady)
        {
            await ShowStationAsync(station);
        }
        else
        {
            _pendingStation = station;
        }
    }

    private async Task ShowStationAsync(StationDetail station)
    {
        _pendingStation = null;
        if (station is not { Latitude: { } lat, Longitude: { } lon })
        {
            return;
        }

        var point = new GeoPoint(lat, lon);
        if (_centerOnStation)
        {
            _centerOnStation = false;
            await _map!.FlyToAsync(point, StationZoom, besidePane: true);
        }
        else
        {
            await _map!.EnsureVisibleAsync(point);
        }
    }

    private void ShowNotice(string message)
    {
        _noticeCts?.Cancel();
        var cts = _noticeCts = new CancellationTokenSource();
        _notice = message;
        _ = ClearNoticeAsync(cts.Token);
    }

    private async Task ClearNoticeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(NoticeDuration, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _notice = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A station starred or un-starred: its marker gains or loses the star.</summary>
    private void OnFavoritesChanged() => InvokeAsync(RenderMarkersAsync);

    /// <summary>The toolbar shows how many stations are compared.</summary>
    private void OnComparisonChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Another release came out, or was rolled back: the offer to reload shows or goes.</summary>
    private void OnUpdateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Another release while the page is away or just back: it reloads by itself.</summary>
    private void OnReloadDue() => InvokeAsync(() => ReloadAsync(automatic: true));

    /// <summary>A new Best near you: the map and the chip follow.</summary>
    private void OnBestChanged() => InvokeAsync(async () =>
    {
        await RenderMarkersAsync();
        await FitToBestAsync();
        StateHasChanged();
    });

    /// <summary>Another car picked, or its fuel changed in My cars: the map takes the car's fuel.</summary>
    private void OnCarsChanged() => InvokeAsync(async () =>
    {
        if (!Cars.IsTypical && Cars.Active.Fuel != _fuel)
        {
            await SetFuelAsync(Cars.Active.Fuel);
        }

        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Favorites.Changed -= OnFavoritesChanged;
        Comparison.Changed -= OnComparisonChanged;
        Updates.Changed -= OnUpdateChanged;
        Updates.ReloadDue -= OnReloadDue;
        Best.Changed -= OnBestChanged;
        Cars.Changed -= OnCarsChanged;
        Updates.Stop();
        _loadCts?.Cancel();
        _retryCts?.Cancel();
        _refreshCts?.Cancel();
        _noticeCts?.Cancel();
        if (_map is not null)
        {
            await _map.DisposeAsync();
        }
    }
}
