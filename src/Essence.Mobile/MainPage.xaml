<?xml version="1.0" encoding="utf-8" ?>
<!-- Essence.UI's map page. SafeAreaEdges keeps it clear of the system bars and the keyboard: .NET 10 draws pages under them. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Essence.Mobile.Components"
             x:Class="Essence.Mobile.MainPage"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
