# Copy to .env and replace every password. Avoid ; = ' and " in them: they are embedded in connection strings.

# PostgreSQL superuser, used by the migrate service only.
POSTGRES_USER=essence_admin
POSTGRES_PASSWORD=ChangeMeAdmin1

# Application roles created by the migrate service (re-applied on every start, so changing them here rotates them).
ESSENCE_WRITER_PASSWORD=ChangeMeWriter1
ESSENCE_READER_PASSWORD=ChangeMeReader1

# Origin allowed to call the API from a browser, or * for any. The default is Essence.Web run with `dotnet watch`;
# the web container needs none: it reaches the API through its own /api/.
CORS_ORIGIN=http://localhost:5173

# Host port of the API.
API_PORT=8080

# Host port of the web app (Essence.Web).
WEB_PORT=8081

# Other copies of what the routing and geocoding containers download (each with an .md5 beside it), and the days between
# their refreshes (0: never). Empty: Geofabrik's Québec extract, Photon's dump of Canada, 30 days.
ROUTING_PBF_URL=
GEOCODING_DUMP_URL=
REFRESH_DAYS=30

# The OpenStreetMap OAuth 2 application users link their own account with, to send their hours corrections there too
# (README → Deploy → OpenStreetMap edits). Empty: the apps don't offer it. For tests, register one on OpenStreetMap's
# development server and point both addresses at https://master.apis.dev.openstreetmap.org (the api doesn't start with
# only one of them there). To link from `dotnet watch`, open http://127.0.0.1:5173 and set CORS_ORIGIN to that.
OSM_CLIENT_ID=
OSM_AUTH_URL=https://www.openstreetmap.org
OSM_API_URL=https://api.openstreetmap.org
