# Copy to .env and replace every password. Avoid ; = ' and " in them: they are embedded in connection strings.

# PostgreSQL superuser, used by the migrate service only.
POSTGRES_USER=essence_admin
POSTGRES_PASSWORD=ChangeMeAdmin1

# Application roles created by the migrate service (re-applied on every start, so changing them here rotates them).
ESSENCE_WRITER_PASSWORD=ChangeMeWriter1
ESSENCE_READER_PASSWORD=ChangeMeReader1

# Origin allowed to call the API from a browser, or * for any. The default is Essence.Web run with `dotnet watch`;
# the web container needs none: it reaches the API through its own /api/.
CORS_ORIGIN=http://localhost:5173

# Host port of the API.
API_PORT=8080

# Host port of the web app (Essence.Web).
WEB_PORT=8081
